IBM Plex Mono',ui-monospace,Menlo,monospace;\n\n--text-display-1:64px;--lh-display-1:1.04;/* @kind other */\n--text-display-2:48px;--lh-display-2:1.08;/* @kind other */\n--text-h1:38px;--lh-h1:1.14;/* @kind other */\n--text-h2:30px;--lh-h2:1.2;/* @kind other */\n--text-h3:23px;--lh-h3:1.28;/* @kind other */\n--text-h4:19px;--lh-h4:1.35;/* @kind other */\n--text-body-lg:19px;--lh-body-lg:1.6;/* @kind other */\n--text-body:16px;--lh-body:1.65;/* @kind other */\n--text-body-sm:14px;--lh-body-sm:1.55;/* @kind other */\n--text-caption:12.5px;--lh-caption:1.4;/* @kind other */\n--text-eyebrow:13px;--lh-eyebrow:1.3;/* @kind other */\n\n--weight-regular:400;--weight-medium:500;--weight-semibold:600;--weight-bold:700;/* @kind other */\n--tracking-eyebrow:.11em;--tracking-tight:-.01em;/* @kind other */\n}\n<\u002Fstyle>\n<style>:root{\n--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:20px;--space-6:24px;--space-8:32px;--space-10:40px;--space-12:48px;--space-16:64px;--space-20:80px;--space-24:96px;--space-32:128px;\n--container-max:1200px;--container-narrow:760px;--container-wide:1440px;\n--gutter:24px;\n}\n<\u002Fstyle>\n<style>:root{\n--radius-sm:4px;--radius-md:8px;--radius-lg:14px;--radius-xl:22px;--radius-pill:999px;\n--shadow-sm:0 1px 2px rgba(36,31,24,.08);\n--shadow-md:0 4px 16px rgba(36,31,24,.10);\n--shadow-lg:0 12px 32px rgba(36,31,24,.14);\n--shadow-inverse:0 4px 20px rgba(0,0,0,.35);\n--border-w:1px;\n--ease-standard:cubic-bezier(.4,0,.2,1);/* @kind other */\n--ease-out:cubic-bezier(0,0,.2,1);/* @kind other */\n--duration-fast:120ms;/* @kind other */--duration-base:200ms;/* @kind other */--duration-slow:360ms;/* @kind other */\n}\n<\u002Fstyle>\n<style>*{box-sizing:border-box}\nbody{margin:0;background:var(--surface-page);color:var(--text-primary);font-family:var(--font-body);font-size:var(--text-body);line-height:var(--lh-body)}\nh1,h2,h3,h4{font-family:var(--font-display);font-weight:var(--weight-medium);margin:0;color:var(--text-primary)}\na{color:var(--text-link);text-decoration:none}\na:hover{color:var(--text-link-hover);text-decoration:underline}\n:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}\n<\u002Fstyle>\n<style>:root{\n--forest-900:#1F2E20;--forest-700:#33492E;--forest-600:#3F5A38;--forest-500:#4C6B45;--moss-400:#7C9468;--moss-300:#9FB587;--sage-200:#C7D4B8;\n--rust-700:#8C4527;--rust-600:#A15334;--rust-500:#B5603A;--rust-300:#D99B72;--rust-100:#F0DBC8;\n--parchment-50:#F8F4E9;--parchment-100:#F1EAD6;--parchment-200:#E4DABF;--parchment-300:#D6C9A8;\n--ink-900:#241F18;--ink-700:#4A4237;--ink-500:#746B5C;--ink-300:#A69C8C;--ink-100:#D9D2C4;\n--sky-500:#6E93A3;\n--success-600:#3F7D4A;--warning-600:#B98A2E;--danger-600:#A83B32;\n\n--surface-page:var(--parchment-50);\n--surface-card:#FFFFFF;\n--surface-card-alt:var(--parchment-100);\n--surface-inverse:var(--forest-900);\n--surface-inverse-alt:var(--forest-700);\n--surface-overlay:rgba(36,31,24,.6);\n\n--text-primary:var(--ink-900);\n--text-secondary:var(--ink-700);\n--text-muted:var(--ink-500);\n--text-on-inverse:var(--parchment-50);\n--text-on-inverse-muted:var(--sage-200);\n--text-link:var(--forest-600);\n--text-link-hover:var(--rust-600);\n\n--border-subtle:var(--parchment-200);\n--border-default:var(--ink-100);\n--border-inverse:rgba(248,244,233,.2);\n\n--accent-primary:var(--forest-600);\n--accent-primary-hover:var(--forest-700);\n--accent-cta:var(--rust-500);\n--accent-cta-hover:var(--rust-700);\n--focus-ring:var(--rust-500);\n\n--status-success:var(--success-600);\n--status-warning:var(--warning-600);\n--status-danger:var(--danger-600);\n}\n\n/* cyrillic-ext */\n@font-face {\n  font-family: 'IBM Plex Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"9a69f059-165b-40f3-8382-ad913a66b019\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'IBM Plex Mono';\n  font-style: normal;\