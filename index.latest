64px;--lh-display-1:1.04;/* @kind other */\n--text-display-2:48px;--lh-display-2:1.08;/* @kind other */\n--text-h1:38px;--lh-h1:1.14;/* @kind other */\n--text-h2:30px;--lh-h2:1.2;/* @kind other */\n--text-h3:23px;--lh-h3:1.28;/* @kind other */\n--text-h4:19px;--lh-h4:1.35;/* @kind other */\n--text-body-lg:19px;--lh-body-lg:1.6;/* @kind other */\n--text-body:16px;--lh-body:1.65;/* @kind other */\n--text-body-sm:14px;--lh-body-sm:1.55;/* @kind other */\n--text-caption:12.5px;--lh-caption:1.4;/* @kind other */\n--text-eyebrow:13px;--lh-eyebrow:1.3;/* @kind other */\n\n--weight-regular:400;--weight-medium:500;--weight-semibold:600;--weight-bold:700;/* @kind other */\n--tracking-eyebrow:.11em;--tracking-tight:-.01em;/* @kind other */\n}\n\n:root{\n--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:20px;--space-6:24px;--space-8:32px;--space-10:40px;--space-12:48px;--space-16:64px;--space-20:80px;--space-24:96px;--space-32:128px;\n--container-max:1200px;--container-narrow:760px;--container-wide:1440px;\n--gutter:24px;\n}\n\n:root{\n--radius-sm:4px;--radius-md:8px;--radius-lg:14px;--radius-xl:22px;--radius-pill:999px;\n--shadow-sm:0 1px 2px rgba(36,31,24,.08);\n--shadow-md:0 4px 16px rgba(36,31,24,.10);\n--shadow-lg:0 12px 32px rgba(36,31,24,.14);\n--shadow-inverse:0 4px 20px rgba(0,0,0,.35);\n--border-w:1px;\n--ease-standard:cubic-bezier(.4,0,.2,1);/* @kind other */\n--ease-out:cubic-bezier(0,0,.2,1);/* @kind other */\n--duration-fast:120ms;/* @kind other */--duration-base:200ms;/* @kind other */--duration-slow:360ms;/* @kind other */\n}\n\n*{box-sizing:border-box}\nbody{margin:0;background:var(--surface-page);color:var(--text-primary);font-family:var(--font-body);font-size:var(--text-body);line-height:var(--lh-body)}\nh1,h2,h3,h4{font-family:var(--font-display);font-weight:var(--weight-medium);margin:0;color:var(--text-primary)}\na{color:var(--text-link);text-decoration:none}\na:hover{color:var(--text-link-hover);text-decoration:underline}\n:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}\n\n<\u002Fstyle>\n<script src=\"98e6577f-bcea-46f9-9639-57b028d7994b\"><\u002Fscript>\n<script src=\"1dff8bcc-5d5b-4d95-be9d-80b5e30b4423\"><\u002Fscript>\n<style>\nbody{margin:0;overflow-x:hidden;background:var(--surface-page);font-family:var(--font-body);}\na{color:var(--text-link);text-decoration:none;}\na:hover{color:var(--text-link-hover);}\nh1,h2,h3,h4{margin:0;font-weight:500;color:inherit;}\np{margin:0;}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div sc-camel-on-click=\"{{ onNav }}\" style=\"min-height:100vh;background:var(--surface-page);color:var(--text-primary);\">\n\n<div style=\"position:sticky;top:0;z-index:40;background:rgba(248,244,233,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--border-subtle);\">\n  <div style=\"max-width:1200px;margin:0 auto;padding:10px clamp(16px,4vw,32px);display:flex;align-items:center;gap:clamp(10px,2vw,24px);flex-wrap:wrap;row-gap:6px;\">\n    <a href=\"#/home\" style=\"color:var(--forest-900);flex:0 1 auto;min-width:0;margin-right:auto;\">\n      <div style=\"font-family:var(--font-display);font-size:clamp(17px,2vw,20px);font-weight:600;line-height:1.15;\">Viv's Nature Scope<\u002Fdiv>\n      <div style=\"font-family:var(--font-mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--rust-600);margin-top:1px;\">Ranikhet · Kumaon<\u002Fdiv>\n    <\u002Fa>\n    <div style=\"flex:1 1 0;min-width:0;display:flex;align-items:center;justify-content:flex-end;gap:clamp(2px,1vw,10px);flex-wrap:nowrap;overflow-x:auto;margin:0 clamp(4px,1vw,14px) 0 0;\">\n      <a href=\"#/tour\" style=\"font-size:14px;font-weight:500;color:var(--text-secondary);padding:11px 6px;white-space:nowrap;\">The tour<\u002Fa>\n      <a href=\"#/birds\" style=\"font-size:14px;font-weight:500;color:var(--text-secondary);padding:11px 8px;white-space:nowrap;\">Birds<\u002Fa>\n      <a href=\"#/gallery\" style=\"font-size:14px;font-weight:500;color:var(--text-secondary);padding:11px 8px;white-space:nowrap;\">Photographs<\u002Fa>\n      <a href=\"#/home\" style=\"font-size:14px;font-weight:500;color:var(--text-secondary);padding:11px 8px;white-space:nowrap;\">Home<\u002Fa>\n    <\u002Fdiv>\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" href=\"#/enquire\" hint-size=\"auto,44px\">Enquire<\u002Fx-import>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<sc-if value=\"{{ isPlan }}\" hint-placeholder-val=\"{{ true }}\">\n<div style=\"max-width:1000px;margin:0 auto;padding:clamp(36px,5vw,56px) clamp(20px,4vw,32px) clamp(56px,8vw,96px);\">\n  <div style=\"font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-cta);margin-bottom:14px;\">Launch version · what shipped<\u002Fdiv>\n  <h1 style=\"font-family:var(--font-display);font-size:clamp(29px,4.2vw,42px);line-height:1.1;max-width:780px;margin-bottom:18px;text-wrap:pretty;\">The smallest site that can take a booking, with nothing in it you can't prove<\u002Fh1>\n  <p style=\"font-size:18px;line-height:1.65;color:var(--text-secondary);max-width:700px;margin-bottom:20px;\">No reviews, no success rates, no \"14 years\", no second guide — and no confessions about being new either. Two tours, both carrying a published from-price, with fixed departures priced in full. Everything a visitor might doubt is answered with a checkable specific instead — meeting point, timings, named lodges, your own photographs.<\u002Fp>\n  <p style=\"font-size:16px;line-height:1.65;color:var(--text-muted);max-width:700px;margin-bottom:32px;\">The fuller six-screen proposal stays in the project as the month-six target — a tours index, guide bios, a review wall and full species guides. Build toward it as you earn the content.<\u002Fp>\n  <div style=\"display:flex;gap:12px;flex-wrap:wrap;margin-bottom:56px;\">\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" size=\"lg\" href=\"#/home\" hint-size=\"auto,48px\">See the homepage<\u002Fx-import>\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" size=\"lg\" variant=\"secondary\" href=\"#/tour\" hint-size=\"auto,48px\">See the tour page<\u002Fx-import>\n  <\u002Fdiv>\n\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-bottom:56px;\">\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:26px;\">\n      <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--forest-600);margin-bottom:14px;\">In, because you can prove it<\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:9px;font-size:14.5px;line-height:1.55;color:var(--text-secondary);\">\n        <div>Two tours, from-priced, with fixed departures carrying one real price each<\u002Fdiv>\n        <div>Day-by-day timings, distances and altitudes<\u002Fdiv>\n        <div>Named lodges and the exact meeting point<\u002Fdiv>\n        <div>Your own photographs, named, with a dated log of recent mornings<\u002Fdiv>\n        <div>What's included, what isn't, what it costs<\u002Fdiv>\n        <div>Your face, your name, where you're from<\u002Fdiv>\n        <div>Honest odds — including the low ones<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:26px;\">\n      <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rust-600);margin-bottom:14px;\">Out, until it's true<\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:9px;font-size:14.5px;line-height:1.55;color:var(--text-secondary);\">\n        <div>Testimonials and star ratings<\u002Fdiv>\n        <div>Five-season success percentages<\u002Fdiv>\n        <div>\"Since 2011\", \"410 tours led\"<\u002Fdiv>\n        <div>A team page with three guides<\u002Fdiv>\n        <div>Four tours you haven't run yet<\u002Fdiv>\n        <div>A species library of 341 birds<\u002Fdiv>\n        <div>Stock photography of the Himalaya<\u002Fdiv>\n        <div>\"Award-winning\", \"world-class\"<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <h2 style=\"font-family:var(--font-display);font-size:clamp(22px,2.8vw,28px);margin-bottom:8px;\">First ninety days<\u002Fh2>\n  <p style=\"font-size:15px;color:var(--text-muted);margin-bottom:22px;\">In order. Don't skip to the species pages.<\u002Fp>\n  <div style=\"display:flex;flex-direction:column;gap:14px;margin-bottom:56px;\">\n    <div style=\"display:grid;grid-template-columns:minmax(80px,110px) 1fr;gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:22px;\">\n      <div style=\"font-family:var(--font-mono);font-size:12px;color:var(--rust-600);padding-top:4px;\">WEEK 1–2<\u002Fdiv>\n      <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Get the enquiry form working, then publish<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">Home, both tours, the enquiry form, the birds index and the photographs page. Nothing else yet. A small site that takes an enquiry beats a big one that doesn't exist — and an untested form is the most common way a new operator loses a month of leads.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:minmax(80px,110px) 1fr;gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:22px;\">\n      <div style=\"font-family:var(--font-mono);font-size:12px;color:var(--rust-600);padding-top:4px;\">WEEK 2–6<\u002Fdiv>\n      <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Run two trips at cost<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">Find them through Facebook birding groups, local naturalist networks, and Indian birders already visiting Kumaon — not international ads. The price of the trip is a review with full name and country, and permission to use your photos of them. That is your entire trust section, earned.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:minmax(80px,110px) 1fr;gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:22px;\">\n      <div style=\"font-family:var(--font-mono);font-size:12px;color:var(--rust-600);padding-top:4px;\">WEEK 3 ON<\u002Fdiv>\n      <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Fill in the birds index, one full guide a week<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">The index already lists 32 species; only Spotted Forktail has a page behind it. Write the rest in the order people search for them, and link each into the index as it lands. Guides take six to twelve months to rank, so starting now means they mature when you have something to sell the traffic. Every one ends with a link to a tour.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:minmax(80px,110px) 1fr;gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:22px;\">\n      <div style=\"font-family:var(--font-mono);font-size:12px;color:var(--rust-600);padding-top:4px;\">WEEK 6–12<\u002Fdiv>\n      <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Publish the reviews you have now earned<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">Add the names, countries and photographs from those first trips — that section replaces every claim the site currently has to make about itself. Only then think about a third route or the Corbett extension, once you know what actually goes wrong on the two you have.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Callout\" tone=\"warning\" title=\"The one thing that will sink this\" hint-size=\"100%,auto\">Stock photography. A visitor deciding whether to wire money to a stranger in India can tell a Getty Himalaya from a photo you took on a ridge at 05:40. Every image block on these screens is a drop target — put your own in, even the imperfect ones.<\u002Fx-import>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isHome }}\" hint-placeholder-val=\"{{ false }}\">\n<div>\n<div style=\"position:relative;height:clamp(420px,58vh,520px);overflow:hidden;\">\n  <img src=\"20021629-aaab-4986-91a8-9eebc11a841f\" alt=\"Sunset over the Kumaon ridges from Majkhali\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 45%;display:block;\">\n  <div style=\"position:absolute;inset:0;background:radial-gradient(85% 80% at 4% 50%,rgba(12,16,11,.82) 0%,rgba(12,16,11,.55) 32%,rgba(12,16,11,0) 62%),linear-gradient(90deg,rgba(16,20,15,.62) 0%,rgba(16,20,15,.3) 26%,rgba(16,20,15,0) 50%),linear-gradient(0deg,rgba(16,20,15,.3) 0%,rgba(16,20,15,0) 35%);pointer-events:none;\"><\u002Fdiv>\n  <div style=\"position:absolute;inset:0;display:flex;align-items:center;pointer-events:none;\">\n    <div style=\"max-width:1200px;margin:0 auto;padding:0 clamp(20px,4vw,32px);width:100%;\">\n      <div style=\"max-width:470px;color:var(--text-on-inverse);text-shadow:0 1px 2px rgba(10,14,9,.55);\">\n        <div style=\"font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--rust-300);margin-bottom:12px;\">Guided birding from Ranikhet, Uttarakhand<\u002Fdiv>\n        <h1 style=\"font-family:var(--font-display);font-size:clamp(25px,3.4vw,34px);line-height:1.12;margin-bottom:12px;text-wrap:pretty;color:#F8F4E9;\">Birding the Kumaon oak forest, with someone who lives in it<\u002Fh1>\n        <p style=\"font-size:15px;line-height:1.6;color:#EDE7DA;margin-bottom:22px;\">Three to seven days out of Ranikhet. Never more than six of you, always guided by me, on the ridges I walk anyway. Published prices, honest odds, no agency in between.<\u002Fp>\n        <div style=\"display:flex;gap:10px;flex-wrap:wrap;pointer-events:auto;\">\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" href=\"#/tour\" hint-size=\"auto,40px\">See the tour and dates<\u002Fx-import>\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" variant=\"secondary\" inverse=\"{{ true }}\" href=\"#/enquire\" hint-size=\"auto,40px\">Enquire<\u002Fx-import>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"background:var(--forest-900);color:var(--text-on-inverse);\">\n  <div style=\"max-width:1200px;margin:0 auto;padding:18px clamp(20px,4vw,32px);display:flex;gap:clamp(20px,3vw,40px);flex-wrap:wrap;justify-content:space-between;font-size:14px;color:var(--text-on-inverse-muted);\">\n    <div><strong style=\"color:var(--rust-300);\">Max 6 guests<\u002Fstrong>, often fewer<\u002Fdiv>\n    <div><strong style=\"color:var(--rust-300);\">3–5 days<\u002Fstrong>, easy walking<\u002Fdiv>\n    <div><strong style=\"color:var(--rust-300);\">From $—— pp<\u002Fstrong>, all land costs<\u002Fdiv>\n    <div><strong style=\"color:var(--rust-300);\">Extensive experience<\u002Fstrong>, Kumaon region<\u002Fdiv>\n    <div><strong style=\"color:var(--rust-300);\">Replies same day<\u002Fstrong>, in English<\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,72px) clamp(20px,4vw,32px) 0;\">\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(28px,4vw,56px);align-items:center;\">\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <div style=\"font-size:12.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-cta);\">Who I am<\u002Fdiv>\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(24px,3.2vw,32px);line-height:1.15;\">I'm Vivasvat. I've spent years birding the Kumaon region — the ridges above Ranikhet, the Binsar sanctuary, the streams. I guide from Majkhali now.<\u002Fh2>\n      <p style=\"font-size:16px;line-height:1.7;color:var(--text-secondary);\">I run these trips myself, one group at a time, which is why there are never more than six of you and why the person answering your email is the person who'll be on the trail with you. Our base is <a href=\"https://www.instagram.com/vivsnaturescope\" target=\"_blank\" rel=\"noopener\">Firwood Cottage<\u002Fa> in Majkhali — early starts, straight into good habitat, no long drive before the day begins.<\u002Fp>\n      <p style=\"font-size:16px;line-height:1.7;color:var(--text-secondary);\">What I do know is the ground: which forest road is worth walking after rain, where the forktails sit on the Chaubatia stream, and which slope has held birds recently. Every photograph on this site is mine, taken on these routes, with the date and the place on it.<\u002Fp>\n      <div style=\"display:flex;gap:12px;flex-wrap:wrap;padding-top:6px;\">\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" variant=\"secondary\" href=\"#/gallery\" hint-size=\"auto,44px\">See my photographs<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" variant=\"link\" href=\"#/enquire\" hint-size=\"auto,24px\">Ask me anything before booking<\u002Fx-import>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"height:clamp(280px,38vw,420px);border-radius:var(--radius-lg);overflow:hidden;\"><image-slot id=\"lv-me\" shape=\"rect\" placeholder=\"A photo of YOU — outdoors, with binoculars. Phone camera is fine. Drag it here.\" src=\"627f9bb8-3da1-497e-b3c3-84a7d7079818\"><\u002Fimage-slot><\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,72px) clamp(20px,4vw,32px) 0;\">\n  <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:8px;\">\n    <h2 style=\"font-family:var(--font-display);font-size:clamp(24px,3.2vw,32px);\">Two tours<\u002Fh2>\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" variant=\"link\" href=\"#/tour\" hint-size=\"auto,24px\">Full day-by-day and dates<\u002Fx-import>\n  <\u002Fdiv>\n  <p style=\"font-size:15px;color:var(--text-muted);margin-bottom:24px;\">Ranikhet for the pheasants, Binsar for the wilderness. Run either on its own, or the two back to back.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;\">\n\n    <a href=\"#/tour\" sc-camel-on-click=\"{{ pickRanikhet }}\" style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;color:inherit;\">\n      <div style=\"height:clamp(200px,24vw,250px);position:relative;\"><img src=\"82b5019e-2018-4219-9455-9d15a30e39a1\" alt=\"Male Cheer Pheasant on a grass slope near Ranikhet\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:58% 62%;display:block;\"><div style=\"position:absolute;left:0;right:0;bottom:0;padding:10px 14px;background:linear-gradient(0deg,rgba(12,16,11,.85) 0%,rgba(12,16,11,0) 100%);color:#F8F4E9;pointer-events:none;\">\n          <div style=\"font-family:var(--font-display);font-size:15px;line-height:1.2;\">Cheer Pheasant<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:12.5px;color:#E2A88C;\">Catreus wallichii<\u002Fdiv>\n        <\u002Fdiv><\u002Fdiv>\n      <div style=\"padding:26px;display:flex;flex-direction:column;gap:12px;flex:1;\">\n        <div style=\"display:flex;gap:8px;flex-wrap:wrap;\">\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,22px\">3–4 days<\u002Fx-import>\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Oct – Apr<\u002Fx-import>\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Easy · 3–5km/day<\u002Fx-import>\n        <\u002Fdiv>\n        <h3 style=\"font-family:var(--font-display);font-size:clamp(21px,2.6vw,26px);line-height:1.15;\">Ranikhet: the pheasant ridges<\u002Fh3>\n        <p style=\"font-size:15px;line-height:1.6;color:var(--text-secondary);flex:1;\">Based at Firwood Cottage in Majkhali. Dawn walks on the orchard tracks, the ridge paths and the Chaubatia stream, at 1,700–2,050m. Around 80–100 species, and the best chance anywhere of Cheer Pheasant.<\u002Fp>\n        <div style=\"font-size:13.5px;color:var(--text-muted);\"><strong style=\"color:var(--text-secondary);\">The draw:<\u002Fstrong> Cheer Pheasant · Kalij · Spotted Forktail · Black-headed Jay<\u002Fdiv>\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-end;border-top:1px solid var(--border-subtle);padding-top:14px;\">\n          <div><div style=\"font-size:12.5px;color:var(--text-muted);\">From<\u002Fdiv><div style=\"font-family:var(--font-display);font-size:26px;color:var(--rust-600);\">₹12,000<\u002Fdiv><div style=\"font-size:11.5px;color:var(--text-muted);\">final price on your itinerary<\u002Fdiv><\u002Fdiv>\n          <span style=\"font-size:14px;font-weight:600;color:var(--rust-600);\">View tour →<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fa>\n\n    <a href=\"#/tour\" sc-camel-on-click=\"{{ pickBinsar }}\" style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;color:inherit;\">\n      <div style=\"height:clamp(200px,24vw,250px);position:relative;\"><img src=\"186e9372-e658-4bce-814a-7ce85f4a609f\" alt=\"Trishul in last light, seen from the Binsar ridge\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 42%;display:block;\"><div style=\"position:absolute;left:0;right:0;bottom:0;padding:10px 14px;background:linear-gradient(0deg,rgba(12,16,11,.85) 0%,rgba(12,16,11,0) 100%);color:#F8F4E9;pointer-events:none;\">\n          <div style=\"font-family:var(--font-display);font-size:15px;line-height:1.2;\">Trishul in last light<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:12.5px;color:#E2A88C;\">seen from the Binsar ridge<\u002Fdiv>\n        <\u002Fdiv><\u002Fdiv>\n      <div style=\"padding:26px;display:flex;flex-direction:column;gap:12px;flex:1;\">\n        <div style=\"display:flex;gap:8px;flex-wrap:wrap;\">\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,22px\">3 days<\u002Fx-import>\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Oct – Apr<\u002Fx-import>\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Moderate · one climb<\u002Fx-import>\n        <\u002Fdiv>\n        <h3 style=\"font-family:var(--font-display);font-size:clamp(21px,2.6vw,26px);line-height:1.15;\">Binsar: inside the sanctuary<\u002Fh3>\n        <p style=\"font-size:15px;line-height:1.6;color:var(--text-secondary);flex:1;\">Two nights at 2,412m inside a protected sanctuary. Less about a target list than about being in it — unbroken oak and rhododendron, no traffic, no village noise, snow peaks on a clear morning.<\u002Fp>\n        <div style=\"font-size:13.5px;color:var(--text-muted);\"><strong style=\"color:var(--text-secondary);\">The draw:<\u002Fstrong> the forest itself · Koklass at dawn · Eurasian Jay · griffons<\u002Fdiv>\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-end;border-top:1px solid var(--border-subtle);padding-top:14px;\">\n          <div><div style=\"font-size:12.5px;color:var(--text-muted);\">From<\u002Fdiv><div style=\"font-family:var(--font-display);font-size:26px;color:var(--rust-600);\">₹12,000<\u002Fdiv><div style=\"font-size:11.5px;color:var(--text-muted);\">final price on your itinerary<\u002Fdiv><\u002Fdiv>\n          <span style=\"font-size:14px;font-weight:600;color:var(--rust-600);\">View tour →<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fa>\n  <\u002Fdiv>\n  <p style=\"font-size:14.5px;line-height:1.65;color:var(--text-secondary);margin-top:18px;max-width:680px;\">Most people do both, Ranikhet first — five days total, one transfer, and the two halves could not be less alike.<\u002Fp>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,72px) clamp(20px,4vw,32px) 0;\">\n  <h2 style=\"font-family:var(--font-display);font-size:clamp(24px,3.2vw,32px);margin-bottom:8px;\">Recent mornings<\u002Fh2>\n  <p style=\"font-size:15px;color:var(--text-muted);margin-bottom:24px;\">Dated, located, unretouched. This is the section that does the work a testimonial can't do yet — keep adding to it every week.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;\">\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n      <div style=\"height:clamp(180px,22vw,220px);\"><img src=\"bec5d849-dadd-4e75-8632-c617489515d2\" alt=\"Asian Barred Owlet on a dead pine snag\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 42%;display:block;\"><\u002Fdiv>\n      <div style=\"padding:18px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:6px;\">JUNE 2026 · MAJKHALI · 18:10<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Asian Barred Owlet<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Glaucidium cuculoides<\u002Fdiv>\n        <div style=\"font-size:14.5px;line-height:1.55;color:var(--text-secondary);\">On a dead pine snag, calling into the fog. It answered a whistled imitation three times.<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n      <div style=\"height:clamp(180px,22vw,220px);\"><img src=\"65d8ec1e-a475-4129-97ad-669e292c838d\" alt=\"Himalayan Black-lored Tit on a thin branch\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 40%;display:block;\"><\u002Fdiv>\n      <div style=\"padding:18px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:6px;\">03 MAR 2026 · RANIKHET CLUB · 07:25<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Himalayan Black-lored Tit<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Machlolophus xanthogenys<\u002Fdiv>\n        <div style=\"font-size:14.5px;line-height:1.55;color:var(--text-secondary);\">Crest up in the scrub at the edge of the orchards, working the seed heads.<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n      <div style=\"height:clamp(180px,22vw,220px);\"><img src=\"5f10c990-b517-4058-ac1d-195864d7f739\" alt=\"Male Koklass Pheasant in grass\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:45% 50%;display:block;\"><\u002Fdiv>\n      <div style=\"padding:18px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:6px;\">18 FEB 2026 · RANIKHET OBT · 06:35<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Koklass Pheasant<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Pucrasia macrolopha<\u002Fdiv>\n        <div style=\"font-size:14.5px;line-height:1.55;color:var(--text-secondary);\">A male out in the open grass for a full minute before it walked back into cover. Usually only a voice.<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n      <div style=\"height:clamp(180px,22vw,220px);\"><img src=\"84b5a982-d5df-4e46-9917-ce260b9a2cf8\" alt=\"Brown-fronted Woodpecker on a pine trunk\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:45% 40%;display:block;\"><\u002Fdiv>\n      <div style=\"padding:18px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:6px;\">11 FEB 2026 · RANIKHET OBT · 08:10<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Brown-fronted Woodpecker<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Dendrocopos auriceps<\u002Fdiv>\n        <div style=\"font-size:14.5px;line-height:1.55;color:var(--text-secondary);\">Working the lichened pines beside the track. Usually the first woodpecker of any trip here.<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n      <div style=\"height:clamp(180px,22vw,220px);\"><img src=\"3d5d554c-8506-454d-b98b-f0c5c710e4bf\" alt=\"Rock Bunting on a bare branch\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:45% 52%;display:block;\"><\u002Fdiv>\n      <div style=\"padding:18px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:6px;\">24 JAN 2026 · MAJKHALI RIDGE · 09:40<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Rock Bunting<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Emberiza cia<\u002Fdiv>\n        <div style=\"font-size:14.5px;line-height:1.55;color:var(--text-secondary);\">A small party on the open ground above the orchards, one bird sitting up long enough for a frame.<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,72px) clamp(20px,4vw,32px) 0;\">\n  <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:8px;\">\n    <h2 style=\"font-family:var(--font-display);font-size:clamp(24px,3.2vw,32px);\">Photographs<\u002Fh2>\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" variant=\"link\" href=\"#/gallery\" hint-size=\"auto,24px\">See the whole collection<\u002Fx-import>\n  <\u002Fdiv>\n  <p style=\"font-size:15px;color:var(--text-muted);margin-bottom:20px;max-width:640px;\">All mine, all taken on these routes. The collection page explains how you can verify that, which matters more than it should when you are booking from another country.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(6,1fr);gap:12px;\">\n      <a href=\"#/gallery\" style=\"display:block;grid-column:span 2;aspect-ratio:1/1;border-radius:var(--radius-md);overflow:hidden;\"><img src=\"82b5019e-2018-4219-9455-9d15a30e39a1\" alt=\"Cheer Pheasant\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fa>\n      <a href=\"#/gallery\" style=\"display:block;grid-column:span 1;aspect-ratio:1/1;border-radius:var(--radius-md);overflow:hidden;\"><img src=\"864a1210-1859-4b94-a1e6-2ac00ad187af\" alt=\"Asian Barred Owlet\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fa>\n      <a href=\"#/gallery\" style=\"display:block;grid-column:span 1;aspect-ratio:1/1;border-radius:var(--radius-md);overflow:hidden;\"><img src=\"91569915-db5b-4d05-8bff-95bcaf369649\" alt=\"Koklass Pheasant\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fa>\n      <a href=\"#/gallery\" style=\"display:block;grid-column:span 1;aspect-ratio:1/1;border-radius:var(--radius-md);overflow:hidden;\"><img src=\"709ced00-37fa-45c3-ad62-7116c8b6078f\" alt=\"Himalayan Black-lored Tit\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fa>\n      <a href=\"#/gallery\" style=\"display:block;grid-column:span 1;aspect-ratio:1/1;border-radius:var(--radius-md);overflow:hidden;\"><img src=\"2bed3a1d-a550-4c02-b66e-a988277cfae9\" alt=\"Brown-fronted Woodpecker\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fa>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:820px;margin:0 auto;padding:clamp(48px,7vw,72px) clamp(20px,4vw,32px) 0;\">\n  <h2 style=\"font-family:var(--font-display);font-size:clamp(23px,3vw,30px);margin-bottom:6px;\">Questions worth asking before you book<\u002Fh2>\n  <p style=\"font-size:15px;color:var(--text-muted);margin-bottom:12px;\">Plain answers, including where the trip has limits.<\u002Fp>\n  <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Accordion\" items=\"{{ homeFaq }}\" default-open-index=\"{{ 0 }}\" hint-size=\"100%,300px\"><\u002Fx-import>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,72px) clamp(20px,4vw,32px) clamp(56px,8vw,96px);\">\n  <div style=\"background:var(--forest-900);color:var(--text-on-inverse);border-radius:var(--radius-lg);padding:clamp(28px,4vw,48px);display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px;align-items:center;\">\n    <div>\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(24px,3.2vw,32px);line-height:1.15;margin-bottom:12px;\">Tell me your dates and I'll tell you what's realistic<\u002Fh2>\n      <p style=\"font-size:16px;line-height:1.6;color:var(--text-on-inverse-muted);max-width:560px;\">Including when the answer is that you should come in a different month. I'd rather lose the booking than have you fly here in June.<\u002Fp>\n    <\u002Fdiv>\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" size=\"lg\" href=\"#/enquire\" hint-size=\"auto,48px\">Enquire<\u002Fx-import>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isTour }}\" hint-placeholder-val=\"{{ false }}\">\n<div>\n<div style=\"background:var(--surface-card-alt);border-bottom:1px solid var(--border-subtle);\">\n  <div style=\"max-width:1200px;margin:0 auto;padding:12px clamp(20px,4vw,32px);display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;\">\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Breadcrumbs\" items=\"{{ tourCrumbs }}\" hint-size=\"auto,18px\"><\u002Fx-import>\n    <div style=\"display:flex;gap:4px;background:var(--surface-card);padding:4px;border-radius:var(--radius-pill);box-shadow:var(--shadow-sm);\">\n      <button sc-camel-on-click=\"{{ showRanikhet }}\" style=\"{{ tabRanikhetStyle }}\">Ranikhet<\u002Fbutton>\n      <button sc-camel-on-click=\"{{ showBinsar }}\" style=\"{{ tabBinsarStyle }}\">Binsar<\u002Fbutton>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<div style=\"position:relative;height:clamp(300px,45vh,400px);overflow:hidden;\">\n  <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"position:absolute;inset:0;\"><img src=\"82b5019e-2018-4219-9455-9d15a30e39a1\" alt=\"Male Cheer Pheasant near Ranikhet\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:58% 62%;display:block;\"><\u002Fdiv><\u002Fsc-if>\n  <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"position:absolute;inset:0;\"><img src=\"ded42708-a169-4213-96d0-e121468f4763\" alt=\"Walking the forest inside Binsar sanctuary\" width=\"1200\" height=\"750\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 42%;display:block;\"><\u002Fdiv><\u002Fsc-if>\n  <div style=\"position:absolute;inset:0;background:linear-gradient(0deg,rgba(12,16,11,.92) 0%,rgba(12,16,11,.72) 22%,rgba(12,16,11,.3) 45%,rgba(12,16,11,0) 68%);pointer-events:none;\"><\u002Fdiv>\n  <div style=\"position:absolute;left:0;right:0;bottom:0;pointer-events:none;\">\n    <div style=\"max-width:1200px;margin:0 auto;padding:0 clamp(20px,4vw,32px) 34px;color:var(--text-on-inverse);text-shadow:0 1px 2px rgba(10,14,9,.5);\">\n      <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;pointer-events:auto;\">\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,22px\">3–4 days<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">October – April<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Easy · 3–5km/day<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Max 6 guests<\u002Fx-import>\n      <\u002Fdiv>\n      <h1 style=\"font-family:var(--font-display);font-size:clamp(28px,4.4vw,44px);line-height:1.08;max-width:800px;color:#F8F4E9;\">Ranikhet: the pheasant ridges<\u002Fh1>\n      <\u002Fsc-if>\n      <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;pointer-events:auto;\">\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,22px\">3 days · 2 nights inside<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">October – April<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Moderate · one climb<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Max 6 guests<\u002Fx-import>\n      <\u002Fdiv>\n      <h1 style=\"font-family:var(--font-display);font-size:clamp(28px,4.4vw,44px);line-height:1.08;max-width:800px;color:#F8F4E9;\">Binsar: inside the sanctuary<\u002Fh1>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(32px,4vw,44px) clamp(20px,4vw,32px) clamp(56px,8vw,96px);display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,56px);align-items:flex-start;\">\n  <div style=\"flex:1 1 460px;min-width:0;display:flex;flex-direction:column;gap:44px;\">\n    <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\">\n    <div style=\"display:flex;flex-direction:column;gap:14px;\">\n      <p style=\"font-size:clamp(16.5px,1.6vw,19px);line-height:1.6;color:var(--text-secondary);\">Based at Firwood Cottage in Majkhali, ten minutes from Ranikhet, walking the ground I know best. Dawn starts at 05:45, 3–5km on graded orchard track and ridge path between 1,700 and 2,050m, back by mid-morning. Afternoons are yours.<\u002Fp>\n      <p style=\"font-size:16px;line-height:1.7;color:var(--text-secondary);\">Three or four days, 80–100 species, and the one place on the trip where Cheer Pheasant is a real prospect. No camping, nothing above 2,100m, and a vehicle within reach all day.<\u002Fp>\n    <\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"display:flex;flex-direction:column;gap:14px;\">\n      <p style=\"font-size:clamp(16.5px,1.6vw,19px);line-height:1.6;color:var(--text-secondary);\">Two nights at 2,412m inside Binsar Wildlife Sanctuary, at the forest rest house. This one is about the place more than the list — unbroken oak and rhododendron, no traffic, no village noise, and snow peaks along the horizon on a clear morning.<\u002Fp>\n      <p style=\"font-size:16px;line-height:1.7;color:var(--text-secondary);\">You walk out of the door into forest, which no lodge outside the gate can offer. Around 6km a day with one real climb, and the rest house is basic on purpose — being inside at first light is the whole point.<\u002Fp>\n    <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <div>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:8px;\">\n        <h2 style=\"font-family:var(--font-display);font-size:clamp(22px,2.8vw,28px);\">How the trip is built<\u002Fh2>\n        <div style=\"display:flex;gap:4px;background:var(--surface-card-alt);padding:4px;border-radius:var(--radius-pill);\">\n          <button sc-camel-on-click=\"{{ showFlexible }}\" style=\"{{ tabFlexStyle }}\">Flexible<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ showFixed }}\" style=\"{{ tabFixedStyle }}\">{{ fixedLabel }}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:18px;\">Two ways to present the same route. Pick whichever matches how you actually want to sell.<\u002Fp>\n\n      <sc-if value=\"{{ isFlexible }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"display:flex;flex-direction:column;gap:28px;\">\n        <div>\n          <h3 style=\"font-family:var(--font-display);font-size:22px;margin-bottom:12px;\">The shape of every day<\u002Fh3>\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;\">\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:18px;\">\n              <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:8px;\">05:45–06:00<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">Out before light<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.55;color:var(--text-secondary);\">Tea, then a short drive to whichever site is best that morning.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:18px;\">\n              <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:8px;\">06:00–10:00<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">The main walk<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.55;color:var(--text-secondary);\">3–5km at birding pace on graded forest road. Packed breakfast on the trail.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:18px;\">\n              <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:8px;\">10:00–16:00<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">Yours<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.55;color:var(--text-secondary);\">Rest, notes, or a slow orchard wander. Birds are quiet, so I don't pretend otherwise.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:18px;\">\n              <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:8px;\">16:30–19:00<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">Evening, optional<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.55;color:var(--text-secondary);\">Second flush of activity, then owling on the forest road if you're up for it.<\u002Fp>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div>\n          <h3 style=\"font-family:var(--font-display);font-size:22px;margin-bottom:6px;\">The places we choose from<\u002Fh3>\n          <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:14px;\">We pick the morning's site the evening before, based on weather and what's been moving.<\u002Fp>\n          <div style=\"display:flex;flex-direction:column;gap:12px;\">\n          <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"display:flex;flex-direction:column;gap:12px;\">\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;align-items:center;\">\n              <div>\n                <div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:4px;\">Ranikhet OBT <a href=\"https://ebird.org/hotspot/L14861807\" target=\"_blank\" rel=\"noopener\" style=\"font-family:var(--font-mono);font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;\">eBird hotspot ↗<\u002Fa><\u002Fdiv>\n                <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Level orchard track, the gentlest morning. Laughingthrushes, Rufous Sibia, Black-headed Jay, Himalayan Woodpecker.<\u002Fp>\n              <\u002Fdiv>\n              <div style=\"font-size:13px;color:var(--text-muted);line-height:1.6;\">1,900m<br>4km, level<\u002Fdiv>\n              <div style=\"display:flex;gap:6px;flex-wrap:wrap;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Every trip<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;align-items:center;\">\n              <div>\n                <div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:4px;\">Majkhali ridge and the shepherd paths<\u002Fdiv>\n                <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Mixed flocks along the ridge line, and the best chance of raptors overhead late morning.<\u002Fp>\n              <\u002Fdiv>\n              <div style=\"font-size:13px;color:var(--text-muted);line-height:1.6;\">2,050m<br>5km, undulating<\u002Fdiv>\n              <div style=\"display:flex;gap:6px;flex-wrap:wrap;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Every trip<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;align-items:center;\">\n              <div>\n                <div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:4px;\">The Chaubatia stream, walked slowly<\u002Fdiv>\n                <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Shaded water and boulders. Spotted Forktail, Plumbeous Water Redstart, Brown Dipper in winter, and the most reliable good birds on the whole route.<\u002Fp>\n              <\u002Fdiv>\n              <div style=\"font-size:13px;color:var(--text-muted);line-height:1.6;\">1,700m<br>2km, level<\u002Fdiv>\n              <div style=\"display:flex;gap:6px;flex-wrap:wrap;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Every trip<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;align-items:center;\">\n              <div>\n                <div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:4px;\">Kosi river, on the transfer<\u002Fdiv>\n                <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Worth building an extra half-day around in winter for Ibisbill and Wallcreeper. Adds a night lower down.<\u002Fp>\n              <\u002Fdiv>\n              <div style=\"font-size:13px;color:var(--text-muted);line-height:1.6;\">600m<br>2km, flat<\u002Fdiv>\n              <div style=\"display:flex;gap:6px;flex-wrap:wrap;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Nov–Feb extension<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <\u002Fsc-if>\n          <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex;flex-direction:column;gap:12px;\">\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;align-items:center;\">\n              <div>\n                <div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:4px;\">Binsar Sanctuary — Zero Point track<\u002Fdiv>\n                <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Less about a target bird than about being in it — unbroken oak and rhododendron, no traffic, no village noise, snow peaks on a clear morning. Needs a night inside the sanctuary to be worth it.<\u002Fp>\n              <\u002Fdiv>\n              <div style=\"font-size:13px;color:var(--text-muted);line-height:1.6;\">2,412m<br>6km, one climb<\u002Fdiv>\n              <div style=\"display:flex;gap:6px;flex-wrap:wrap;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Both mornings<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;align-items:center;\">\n              <div>\n                <div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:4px;\">The rest-house clearing, before anyone is up<\u002Fdiv>\n                <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">You do not have to go anywhere. Mixed flocks come through the oaks at the edge of the clearing, and this is where Eurasian Jay usually turns up.<\u002Fp>\n              <\u002Fdiv>\n              <div style=\"font-size:13px;color:var(--text-muted);line-height:1.6;\">2,412m<br>no walking<\u002Fdiv>\n              <div style=\"display:flex;gap:6px;flex-wrap:wrap;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Every morning<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;align-items:center;\">\n              <div>\n                <div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:4px;\">The stream gullies below the ridge<\u002Fdiv>\n                <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Steep, wet, and worth it. Forktails and redstarts on the water, and the deepest forest on the trip. Not a walk for anyone unsure on descents.<\u002Fp>\n              <\u002Fdiv>\n              <div style=\"font-size:13px;color:var(--text-muted);line-height:1.6;\">2,100m<br>3km, steep<\u002Fdiv>\n              <div style=\"display:flex;gap:6px;flex-wrap:wrap;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">Weather allowing<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\">\n        <div style=\"background:var(--forest-900);color:var(--text-on-inverse);border-radius:var(--radius-lg);padding:clamp(24px,3vw,32px);\">\n          <div style=\"font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);margin-bottom:10px;\">The pheasants<\u002Fdiv>\n          <h3 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);line-height:1.15;margin-bottom:10px;\">Ranikhet is one of the few reliable places left for Cheer Pheasant<\u002Fh3>\n          <p style=\"font-size:15px;line-height:1.65;color:var(--text-on-inverse-muted);margin-bottom:22px;max-width:660px;\">It is the reason to come here rather than anywhere else in the Himalaya, and the reason this is the tour I'd book first. Here is where I'd set expectations, in order.<\u002Fp>\n\n          <div style=\"background:rgba(178,86,45,.24);border:1px solid var(--rust-500);border-radius:var(--radius-md);padding:22px;margin-bottom:16px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between;\">\n            <div style=\"flex:1 1 220px;min-width:0;max-width:320px;height:200px;border-radius:var(--radius-md);overflow:hidden;\"><img src=\"82b5019e-2018-4219-9455-9d15a30e39a1\" alt=\"Male Cheer Pheasant, Catreus wallichii\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:58% 62%;display:block;\"><\u002Fdiv>\n            <div style=\"flex:1 1 300px;min-width:0;\">\n              <div style=\"display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;margin-bottom:6px;\">\n                <span style=\"font-family:var(--font-display);font-size:clamp(22px,2.4vw,26px);\">Cheer Pheasant<\u002Fspan>\n                <span style=\"font-family:var(--font-display);font-style:italic;font-size:15px;color:var(--rust-300);\">Catreus wallichii<\u002Fspan>\n                <span style=\"font-family:var(--font-mono);font-size:11px;background:rgba(248,244,233,.14);padding:3px 8px;border-radius:var(--radius-sm);\">VULNERABLE<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rust-300);margin-bottom:8px;\">Why people come to Ranikhet<\u002Fdiv>\n              <p style=\"font-size:14.5px;line-height:1.6;color:var(--text-on-inverse-muted);\">Global range is a thin band of the western Himalaya, and the grass-and-scrub slopes around Ranikhet hold one of the few dependable populations. It is the one bird I will not oversell: the dawn call carries a long way, the sighting is often brief, and some mornings give you nothing. We look for it on one morning of a three-day trip, and get a second attempt on the four.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"flex:0 0 auto;text-align:right;\">\n              <div style=\"font-family:var(--font-display);font-size:26px;\">[ n of n ]<\u002Fdiv>\n              <div style=\"font-size:12px;color:var(--rust-300);\">attempts connected<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;\">\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"height:110px;border-radius:var(--radius-sm);overflow:hidden;margin-bottom:12px;\"><img src=\"91569915-db5b-4d05-8bff-95bcaf369649\" alt=\"Male Koklass Pheasant\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Koklass Pheasant<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Pucrasia macrolopha<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">Heard at dawn far more often than seen. Calling from the ridges above Majkhali most mornings in spring.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Kalij Pheasant<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Lophura leucomelanos<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">The easy one. On the forest road at dusk, often a family party crossing in front of the vehicle.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"height:110px;border-radius:var(--radius-sm);overflow:hidden;margin-bottom:12px;\"><img src=\"2bed3a1d-a550-4c02-b66e-a988277cfae9\" alt=\"Brown-fronted Woodpecker\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Brown-fronted Woodpecker<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Dendrocopos auriceps<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">On the lichened pines along every track we walk. Usually the first woodpecker of the trip, often with Himalayan Woodpecker nearby.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"height:110px;border-radius:var(--radius-sm);overflow:hidden;margin-bottom:12px;\"><img src=\"864a1210-1859-4b94-a1e6-2ac00ad187af\" alt=\"Asian Barred Owlet\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 40%;display:block;\"><\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Owlets, two kinds<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Glaucidium cuculoides · G. brodiei<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">Asian Barred and Collared Owlet both call through the afternoon from the pines, and both answer a whistled imitation. The reason the optional evening walk is worth doing.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Steppe Eagle<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Aquila nipalensis<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">A winter and passage bird here, drifting along the ridge line on a warm afternoon. Numbers build from November.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"height:110px;border-radius:var(--radius-sm);overflow:hidden;margin-bottom:12px;\"><img src=\"709ced00-37fa-45c3-ad62-7116c8b6078f\" alt=\"Himalayan Black-lored Tit\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-size:18px;\">The oak-forest supporting cast<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Mixed flocks, all day<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">Himalayan Black-lored Tit (above) · Rock Bunting · White-tailed Nuthatch · Great Barbet · Rufous Sibia · Black-headed Jay.<\u002Fp>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"background:var(--forest-900);color:var(--text-on-inverse);border-radius:var(--radius-lg);padding:clamp(24px,3vw,32px);\">\n          <div style=\"font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);margin-bottom:10px;\">The sanctuary<\u002Fdiv>\n          <h3 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);line-height:1.15;margin-bottom:10px;\">Binsar is about walking in true Himalayan sanctuary wilderness<\u002Fh3>\n          <p style=\"font-size:15px;line-height:1.65;color:var(--text-on-inverse-muted);margin-bottom:22px;max-width:660px;\">Come here for the forest rather than for a target bird. Binsar is an Important Bird Area with 173 recorded species, but the reason to spend the nights inside is that there is nothing else inside — no traffic, no village, no other groups at dawn. The birds are what happens while you are standing in it.<\u002Fp>\n\n          <div style=\"background:rgba(178,86,45,.24);border:1px solid var(--rust-500);border-radius:var(--radius-md);padding:22px;margin-bottom:16px;\">\n            <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rust-300);margin-bottom:8px;\">What the two nights actually buy<\u002Fdiv>\n            <p style=\"font-size:14.5px;line-height:1.6;color:var(--text-on-inverse-muted);max-width:700px;\">Unbroken oak and rhododendron from the door of the rest house, first light without a drive, and the Zero Point ridge with snow peaks along the horizon on a clear morning. Nobody staying outside the gate gets any of that. In exchange the rest house is basic — cold water some mornings, simple food, no phone signal worth the name.<\u002Fp>\n          <\u002Fdiv>\n\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;\">\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Koklass Pheasant<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Pucrasia macrolopha<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">Heard at dawn far more often than seen. Calling from the ridge above Zero Point most mornings in spring.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Kalij Pheasant<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Lophura leucomelanos<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">The easy one. On the forest road at dusk, often a family party crossing in front of the vehicle.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Eurasian Jay<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Garrulus glandarius<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">Localised here and wanted by most visiting birders. Oak canopy, usually alongside Black-headed Jay.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Himalayan Griffon<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Gyps himalayensis<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">Late morning over the ridges once the thermals build. Best watched from the Zero Point viewpoint.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Steppe Eagle<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Aquila nipalensis<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">On passage and through the winter, using the same thermals as the griffons. The Zero Point ridge is the place to sit and wait.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">Asian Barred Owlet<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Glaucidium cuculoides<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">Daytime calling from the oaks around the rest house, and the easiest owl to actually see rather than hear.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:rgba(248,244,233,.08);border-radius:var(--radius-md);padding:16px;\">\n              <div style=\"font-family:var(--font-display);font-size:18px;\">The oak-forest supporting cast<\u002Fdiv>\n              <div style=\"font-family:var(--font-display);font-style:italic;font-size:13px;color:var(--rust-300);margin-bottom:6px;\">Mixed flocks, all day<\u002Fdiv>\n              <p style=\"font-size:13.5px;line-height:1.5;color:var(--text-on-inverse-muted);\">White-tailed Nuthatch · Black-throated Sunbird · Great Barbet · Rufous Sibia · Yellow-bellied Fantail · Spotted Forktail.<\u002Fp>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\">\n        <div>\n          <h3 style=\"font-family:var(--font-display);font-size:22px;margin-bottom:6px;\">Two ways to do the Ranikhet tour<\u002Fh3>\n          <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:14px;\">Same base at Firwood Cottage either way. The fourth day buys a second attempt at the Cheer ridge. Prices below are starting figures for a private trip — I quote the real one against your itinerary.<\u002Fp>\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;\">\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:22px;display:flex;flex-direction:column;gap:10px;\">\n              <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);\">3 days · 2 nights<\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px;\"><div style=\"font-family:var(--font-display);font-size:22px;line-height:1.15;\">Ranikhet, short<\u002Fdiv><div style=\"font-size:15px;font-weight:700;color:var(--rust-600);\">from ₹12,000<\u002Fdiv><\u002Fdiv>\n              <p style=\"font-size:14px;line-height:1.6;color:var(--text-secondary);flex:1;\">Two dawns on the Ranikhet OBT, the Majkhali ridge and the Chaubatia stream. Around 80 species. Right if you are adding the hills onto a Delhi or Corbett trip.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:22px;display:flex;flex-direction:column;gap:10px;border:1px solid var(--rust-300);\">\n              <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-600);\">4 days · 3 nights<\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px;\"><div style=\"font-family:var(--font-display);font-size:22px;line-height:1.15;\">Ranikhet, full<\u002Fdiv><div style=\"font-size:15px;font-weight:700;color:var(--rust-600);\">from ₹12,000<\u002Fdiv><\u002Fdiv>\n              <p style=\"font-size:14px;line-height:1.6;color:var(--text-secondary);flex:1;\">The version I would book. Adds the pre-dawn Cheer Pheasant morning and a spare afternoon, which is what turns a maybe into a decent chance. Around 100 species.<\u002Fp>\n              <div style=\"display:flex;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,22px\">Most people choose this<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <p style=\"font-size:14.5px;line-height:1.65;color:var(--text-secondary);margin-top:14px;\">Add the Binsar tour on the end for five days total, or a night low down on the Kosi in winter for Ibisbill and Wallcreeper. Say so at enquiry and I will price it as one trip.<\u002Fp>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\">\n        <div>\n          <h3 style=\"font-family:var(--font-display);font-size:22px;margin-bottom:6px;\">Two ways to do Binsar<\u002Fh3>\n          <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:14px;\">Two nights inside the sanctuary is the minimum that justifies the drive. Most people arrive from Ranikhet. Prices below are starting figures for a private trip — I quote the real one against your itinerary.<\u002Fp>\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;\">\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:22px;display:flex;flex-direction:column;gap:10px;\">\n              <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);\">3 days · 2 nights inside<\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px;\"><div style=\"font-family:var(--font-display);font-size:22px;line-height:1.15;\">Binsar on its own<\u002Fdiv><div style=\"font-size:15px;font-weight:700;color:var(--rust-600);\">from ₹12,000<\u002Fdiv><\u002Fdiv>\n              <p style=\"font-size:14px;line-height:1.6;color:var(--text-secondary);flex:1;\">Straight up to the rest house, two full days walking the Zero Point track and the stream gullies, then down. For anyone who wants the forest rather than a list.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:22px;display:flex;flex-direction:column;gap:10px;border:1px solid var(--rust-300);\">\n              <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-600);\">5 days · 4 nights<\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px;\"><div style=\"font-family:var(--font-display);font-size:22px;line-height:1.15;\">Ranikhet, then Binsar<\u002Fdiv><div style=\"font-size:15px;font-weight:700;color:var(--rust-600);\">from ₹12,000<\u002Fdiv><\u002Fdiv>\n              <p style=\"font-size:14px;line-height:1.6;color:var(--text-secondary);flex:1;\">The Ranikhet mornings for the pheasants, then two nights inside the sanctuary. One transfer, two completely unalike halves. Around 120 species.<\u002Fp>\n              <div style=\"display:flex;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,22px\">Most people choose this<\u002Fx-import><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <p style=\"font-size:14.5px;line-height:1.65;color:var(--text-secondary);margin-top:14px;\">The rest house is basic and beds inside the sanctuary are limited, so Binsar dates need more notice than Ranikhet ones — a month at least.<\u002Fp>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isFixed }}\" hint-placeholder-val=\"{{ false }}\">\n      <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:flex;flex-direction:column;gap:14px;\">\n        <div style=\"display:grid;grid-template-columns:minmax(64px,80px) 1fr;gap:16px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;\">\n          <div style=\"font-family:var(--font-mono);font-size:12.5px;color:var(--rust-600);padding-top:3px;\">DAY 1<\u002Fdiv>\n          <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Up to the sanctuary, 2,412m<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">I meet you at Kathgodam, Pantnagar or in Ranikhet — exact meeting point and my phone number sent a week ahead. Transfer up through the oak belt, into the gate, and settled at the forest rest house by afternoon. Late walk on the ridge track for Kalij on the road at dusk.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:minmax(64px,80px) 1fr;gap:16px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;\">\n          <div style=\"font-family:var(--font-mono);font-size:12.5px;color:var(--rust-600);padding-top:3px;\">DAY 2<\u002Fdiv>\n          <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Zero Point, and the day in the forest<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">Out of the door at first light — no drive. Koklass calling from above, mixed flocks through the oaks, and the ridge for snow peaks and griffons once the thermals build. Afternoon down into the stream gullies if the weather holds.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:minmax(64px,80px) 1fr;gap:16px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;\">\n          <div style=\"font-family:var(--font-mono);font-size:12.5px;color:var(--rust-600);padding-top:3px;\">DAY 3<\u002Fdiv>\n          <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Last dawn, then down<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">A final morning at the rest-house clearing and on the track, then the transfer out. I plan the return so you are not making a same-night international connection out of Delhi.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n      <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"display:flex;flex-direction:column;gap:14px;\">\n        <div style=\"display:grid;grid-template-columns:minmax(64px,80px) 1fr;gap:16px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;\">\n          <div style=\"font-family:var(--font-mono);font-size:12.5px;color:var(--rust-600);padding-top:3px;\">DAY 1<\u002Fdiv>\n          <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Arrive Ranikhet<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">I meet you at Kathgodam station or Pantnagar airport — exact meeting point and my phone number are sent a week ahead. Road transfer of 3 to 4 hours with a stop at the Kosi barrage if the light holds. Evening: kit check and a look at the plan.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:minmax(64px,80px) 1fr;gap:16px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;\">\n          <div style=\"font-family:var(--font-mono);font-size:12.5px;color:var(--rust-600);padding-top:3px;\">DAY 2<\u002Fdiv>\n          <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Ranikhet OBT <a href=\"https://ebird.org/hotspot/L14861807\" target=\"_blank\" rel=\"noopener\" style=\"font-family:var(--font-mono);font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;\">eBird hotspot ↗<\u002Fa><\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">05:45 start, ten minutes by road, then 4km on level orchard track at 1,900m. Laughingthrushes, Rufous Sibia, Black-headed Jay, Himalayan Woodpecker, first Kalij. Back by 10:00. Optional short evening walk for owlets.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:minmax(64px,80px) 1fr;gap:16px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;\">\n          <div style=\"font-family:var(--font-mono);font-size:12.5px;color:var(--rust-600);padding-top:3px;\">DAY 3<\u002Fdiv>\n          <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">The Cheer ridge, pre-dawn<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">The early one: out at 05:15, a short drive, then up onto the grass slopes to be in position before the light. Cheer Pheasant call carries a long way before dawn. Koklass on the walk down, and the rest of the morning on the Chaubatia stream for forktails and redstarts. Afternoon off.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:minmax(64px,80px) 1fr;gap:16px;background:var(--surface-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);padding:20px;\">\n          <div style=\"font-family:var(--font-mono);font-size:12.5px;color:var(--rust-600);padding-top:3px;\">DAY 4<\u002Fdiv>\n          <div><div style=\"font-family:var(--font-display);font-size:20px;margin-bottom:6px;\">Majkhali ridge, then departure<\u002Fdiv><p style=\"font-size:14.5px;line-height:1.6;color:var(--text-secondary);\">A last morning on the shepherd paths above the cottage — mixed flocks, and raptors overhead late — then the transfer out. I plan the return so you are not making a same-night international connection out of Delhi.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fsc-if>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n\n    <div>\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(22px,2.8vw,28px);margin-bottom:6px;\">What you'll probably see<\u002Fh2>\n      <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:18px;\">Honest categories rather than invented percentages.<\u002Fp>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;\">\n        <div style=\"background:rgba(51,73,46,.09);border-radius:var(--radius-md);padding:20px;\">\n          <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--forest-700);margin-bottom:10px;\">Most mornings<\u002Fdiv>\n          <div style=\"font-size:14.5px;line-height:1.7;color:var(--text-secondary);\">Kalij Pheasant · Rufous Sibia · Black-headed Jay · Great Barbet · Blue Whistling Thrush · Plumbeous Water Redstart · Streaked Laughingthrush<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"background:rgba(178,86,45,.11);border-radius:var(--radius-md);padding:20px;\">\n          <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rust-700);margin-bottom:10px;\">With luck and an early start<\u002Fdiv>\n          <div style=\"font-size:14.5px;line-height:1.7;color:var(--text-secondary);\">Spotted Forktail · Brown Dipper · Collared Owlet · Maroon Oriole · Long-tailed Broadbill<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:20px;\">\n          <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:10px;\">What I won't promise<\u002Fdiv>\n          <div style=\"font-size:14.5px;line-height:1.7;color:var(--text-secondary);\">Don't come with a guarantee in mind. These are wild birds on a hillside — I make no promises about any single species, and anyone who does is selling you something. What I will promise is that I'll put in the early starts, the waiting and the local knowledge to give you the best chance the season allows, and that I'll tell you straight what we did and didn't find.<\u002Fdiv>\n          \n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;\">\n      <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:24px;\">\n        <h3 style=\"font-family:var(--font-display);font-size:21px;margin-bottom:12px;\">Included<\u002Fh3>\n        <sc-if value=\"{{ isRanikhetTour }}\" hint-placeholder-val=\"{{ true }}\">\n        <div style=\"display:flex;flex-direction:column;gap:8px;font-size:14.5px;line-height:1.5;color:var(--text-secondary);\">\n          <div>Three nights twin-share at <a href=\"https://www.instagram.com/vivsnaturescope\" target=\"_blank\" rel=\"noopener\">Firwood Cottage<\u002Fa>, Majkhali<\u002Fdiv>\n          <div>All meals, packed breakfast on dawn starts<\u002Fdiv>\n          <div>Private vehicle and driver throughout<\u002Fdiv>\n          <div>Me, guiding, every day<\u002Fdiv>\n          <div>Transfers from Kathgodam or Pantnagar<\u002Fdiv>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ isBinsarTour }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"display:flex;flex-direction:column;gap:8px;font-size:14.5px;line-height:1.5;color:var(--text-secondary);\">\n          <div>Two nights twin-share at the Binsar forest rest house, inside the sanctuary<\u002Fdiv>\n          <div>All meals, packed breakfast on dawn starts<\u002Fdiv>\n          <div>Private vehicle and driver throughout<\u002Fdiv>\n          <div>Me, guiding, every day<\u002Fdiv>\n          <div>Binsar sanctuary entry and permits<\u002Fdiv>\n          <div>Transfers from Kathgodam, Pantnagar or Ranikhet<\u002Fdiv>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n      <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:24px;\">\n        <h3 style=\"font-family:var(--font-display);font-size:21px;margin-bottom:12px;\">Not included<\u002Fh3>\n        <div style=\"display:flex;flex-direction:column;gap:8px;font-size:14.5px;line-height:1.5;color:var(--text-secondary);\">\n          <div>Flights and the India e-visa (about $25)<\u002Fdiv>\n          <div>Travel and medical insurance — required<\u002Fdiv>\n          <div>Single supplement, $—— for the trip<\u002Fdiv>\n          <div>Alcohol, laundry, tips<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:28px;\">\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin-bottom:8px;\">Combining with Corbett<\u002Fh2>\n      <p style=\"font-size:15px;line-height:1.65;color:var(--text-secondary);margin-bottom:20px;\">Most people flying in for Kumaon do Corbett too, and they should — it's a different bird list entirely. I don't run trips inside the park: it needs park-licensed naturalists, quota permits and safari slots booked months out, and you're better served by someone who does that every week. What I can do is make the two halves fit.<\u002Fp>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;margin-bottom:18px;\">\n        <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:18px;\">\n          <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:8px;\">HILLS FIRST<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">Ranikhet → Corbett<\u002Fdiv>\n          <p style=\"font-size:13.5px;line-height:1.55;color:var(--text-secondary);\">The way I'd do it. Altitude birds while you're fresh, then drop to the terai. 3.5 hours by road, and I can stop you at the Kosi on the way down.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:18px;\">\n          <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:8px;\">PARK FIRST<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">Corbett → Ranikhet<\u002Fdiv>\n          <p style=\"font-size:13.5px;line-height:1.55;color:var(--text-secondary);\">Works if your Dhikala dates are fixed and the hills have to fit around them. Same transfer, and you finish somewhere quiet.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:18px;\">\n          <div style=\"font-family:var(--font-mono);font-size:11.5px;color:var(--rust-600);margin-bottom:8px;\">MINIMUM<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">3 + 3 nights<\u002Fdiv>\n          <p style=\"font-size:13.5px;line-height:1.55;color:var(--text-secondary);\">Less than three in the hills and you spend most of it travelling. Ten days total is where the trip stops feeling rushed.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <p style=\"font-size:14.5px;line-height:1.65;color:var(--text-secondary);\">Tell me at enquiry that Corbett is in the plan and I'll send the operators I'd use myself, along with the dates that leave enough margin between the two halves. No commission, no markup — I just want your hill days to work.<\u002Fp>\n    <\u002Fdiv>\n\n    <div>\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(22px,2.8vw,28px);margin-bottom:16px;\">Before you ask<\u002Fh2>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Accordion\" items=\"{{ tourFaq }}\" default-open-index=\"{{ 0 }}\" hint-size=\"100%,320px\"><\u002Fx-import>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"flex:1 1 300px;max-width:360px;position:sticky;top:80px;align-self:flex-start;display:flex;flex-direction:column;gap:16px;\">\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:24px;display:flex;flex-direction:column;gap:16px;\">\n      <div>\n        <div style=\"font-size:12.5px;color:var(--text-muted);\">Private trips, from<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:36px;line-height:1.1;color:var(--rust-600);\">₹12,000<\u002Fdiv>\n        <div style=\"font-size:13px;color:var(--text-muted);\">per person, twin share · all land costs<\u002Fdiv>\n        <div style=\"font-size:12.5px;line-height:1.55;color:var(--text-muted);margin-top:8px;\">Indicative. The final figure depends on how many days you take, party size, rooms and how much driving your route needs — I quote it in full once the itinerary is settled, with nothing added later.<\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:10px;border-top:1px solid var(--border-subtle);padding-top:16px;\">\n        <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);\">Fixed departures<\u002Fdiv>\n        <div style=\"font-size:12.5px;line-height:1.55;color:var(--text-muted);margin-top:-4px;\">Set dates, set route, one price per person — no quote needed.<\u002Fdiv>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14.5px;\"><span>[Date 1]<\u002Fspan><span style=\"display:flex;align-items:center;gap:8px;\"><strong style=\"color:var(--rust-600);\">₹12,000<\u002Fstrong><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Badge\" status=\"success\" hint-size=\"auto,20px\">Open<\u002Fx-import><\u002Fspan><\u002Fdiv>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14.5px;\"><span>[Date 2]<\u002Fspan><span style=\"display:flex;align-items:center;gap:8px;\"><strong style=\"color:var(--rust-600);\">₹12,000<\u002Fstrong><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Badge\" status=\"success\" hint-size=\"auto,20px\">Open<\u002Fx-import><\u002Fspan><\u002Fdiv>\n        <div style=\"font-size:13px;line-height:1.55;color:var(--text-muted);\">Or name your own dates — most trips this season will be private.<\u002Fdiv>\n      <\u002Fdiv>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" size=\"lg\" href=\"#/enquire\" hint-size=\"100%,48px\">Enquire about this tour<\u002Fx-import>\n      <div style=\"font-size:12.5px;line-height:1.6;color:var(--text-muted);border-top:1px solid var(--border-subtle);padding-top:14px;\">Enquiring costs nothing and holds no place. I reply the same day, and I only ask for a deposit once you have the itinerary in writing.<\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-lg);padding:20px;font-size:13.5px;line-height:1.65;color:var(--text-secondary);\">\n      <strong style=\"color:var(--text-primary);\">Rather talk first?<\u002Fstrong><br>WhatsApp +91 99719 24583, 07:00–21:00 IST. Happy to take a call in your evening — say the word and I'll stay up.\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isEnquire }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"max-width:1040px;margin:0 auto;padding:clamp(36px,5vw,56px) clamp(20px,4vw,32px) clamp(56px,8vw,96px);display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,56px);align-items:flex-start;\">\n  <div>\n    <h1 style=\"font-family:var(--font-display);font-size:clamp(28px,4vw,40px);line-height:1.1;margin-bottom:12px;\">Enquire<\u002Fh1>\n    <p style=\"font-size:17px;line-height:1.6;color:var(--text-secondary);margin-bottom:32px;max-width:600px;\">Four fields are required. The rest just helps me answer properly the first time instead of sending you three emails.<\u002Fp>\n\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:28px;display:flex;flex-direction:column;gap:26px;\">\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;\">\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Input\" label=\"Name\" placeholder=\"Your name\" hint-size=\"100%,70px\"><\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Input\" label=\"Email\" type=\"email\" placeholder=\"you@example.com\" hint-size=\"100%,70px\"><\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Input\" label=\"When would you travel?\" placeholder=\"March 2027, or flexible\" hint-size=\"100%,70px\"><\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Input\" label=\"How many people?\" placeholder=\"2 adults\" hint-size=\"100%,70px\"><\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Input\" label=\"Country you're travelling from\" placeholder=\"Optional — helps me time my reply\" hint-size=\"100%,70px\"><\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Input\" label=\"WhatsApp\" placeholder=\"Optional\" hint-size=\"100%,70px\"><\u002Fx-import>\n      <\u002Fdiv>\n\n      <div style=\"display:flex;flex-direction:column;gap:12px;\">\n        <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);\">Pace you'd prefer<\u002Fdiv>\n        <div style=\"display:flex;gap:10px;flex-wrap:wrap;\">\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" hint-size=\"auto,26px\">Happy with dawn starts and hills<\u002Fx-import>\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" hint-size=\"auto,26px\">A few km on the flat is fine<\u002Fx-import>\n          <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" hint-size=\"auto,26px\">Mostly vehicle-based, please<\u002Fx-import>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <label style=\"display:flex;flex-direction:column;gap:6px;\">\n        <span style=\"font-size:13.5px;font-weight:600;\">What you're hoping for, and anything I should know<\u002Fspan>\n        <textarea placeholder=\"Target species, first trip to India, dietary needs, a knee that objects to descents, whether you're combining this with Corbett or Delhi…\" style=\"padding:12px 14px;font-size:14.5px;font-family:var(--font-body);border:1px solid var(--border-default);border-radius:var(--radius-sm);min-height:120px;resize:vertical;color:var(--text-primary);background:var(--surface-card);\"><\u002Ftextarea>\n      <\u002Flabel>\n\n      <div style=\"display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;border-top:1px solid var(--border-subtle);padding-top:20px;\">\n        <div style=\"font-size:13px;color:var(--text-muted);max-width:340px;\">I reply the same day. No mailing list, no deposit at this stage.<\u002Fdiv>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" size=\"lg\" hint-size=\"auto,48px\">Send enquiry<\u002Fx-import>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"flex:1 1 300px;max-width:340px;display:flex;flex-direction:column;gap:16px;position:sticky;top:80px;align-self:flex-start;\">\n    <div style=\"background:var(--forest-900);color:var(--text-on-inverse);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:14px;\">\n      <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--rust-300);\">What happens next<\u002Fdiv>\n      <div style=\"display:flex;gap:12px;\"><span style=\"font-family:var(--font-mono);font-size:12px;color:var(--rust-300);padding-top:2px;\">01<\u002Fspan><div style=\"font-size:14.5px;line-height:1.55;\">I read it myself and reply the same day. There is no office, no agent — it's me.<\u002Fdiv><\u002Fdiv>\n      <div style=\"display:flex;gap:12px;\"><span style=\"font-family:var(--font-mono);font-size:12px;color:var(--rust-300);padding-top:2px;\">02<\u002Fspan><div style=\"font-size:14.5px;line-height:1.55;\">You get a written itinerary and a full price built against it — nothing hidden, nothing added later — plus an honest read on your dates.<\u002Fdiv><\u002Fdiv>\n      <div style=\"display:flex;gap:12px;\"><span style=\"font-family:var(--font-mono);font-size:12px;color:var(--rust-300);padding-top:2px;\">03<\u002Fspan><div style=\"font-size:14.5px;line-height:1.55;\">Only when you're happy with it do I ask for a 20% deposit.<\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:22px;font-size:14px;line-height:1.65;color:var(--text-secondary);\">\n      <strong style=\"color:var(--text-primary);font-family:var(--font-display);font-size:17px;\">Rather not fill a form?<\u002Fstrong>\n      <div style=\"margin-top:8px;\">WhatsApp <strong style=\"color:var(--text-primary);\">+91 99719 24583<\u002Fstrong>, 07:00–21:00 IST.<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isBirds }}\" hint-placeholder-val=\"{{ false }}\">\n<div>\n<div style=\"background:var(--forest-900);color:var(--text-on-inverse);\">\n  <div style=\"max-width:1200px;margin:0 auto;padding:clamp(36px,5vw,52px) clamp(20px,4vw,32px);\">\n    <div style=\"font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--rust-300);margin-bottom:12px;\">Birds of Ranikhet<\u002Fdiv>\n    <h1 style=\"font-family:var(--font-display);font-size:clamp(28px,4vw,42px);line-height:1.1;max-width:780px;margin-bottom:14px;color:#F8F4E9;\">What you can expect to see around Ranikhet, Majkhali and Binsar<\u002Fh1>\n    <p style=\"font-size:16.5px;line-height:1.65;color:var(--text-on-inverse-muted);max-width:680px;\">Between 1,400m and 2,450m, October to April. Grouped the way you actually meet them on a morning, rather than by taxonomy. Species with a full guide are linked; the rest are on the list as I write them.<\u002Fp>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(20px,3vw,28px) clamp(20px,4vw,32px) clamp(56px,8vw,96px);\">\n  <div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:14px 16px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);\">\n    <span style=\"font-size:13px;font-weight:600;color:var(--text-muted);margin-right:4px;\">Jump to<\u002Fspan>\n    <a href=\"#g-pheasants\" style=\"text-decoration:none;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,24px\">Pheasants<\u002Fx-import><\u002Fa>\n    <a href=\"#g-raptors\" style=\"text-decoration:none;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,24px\">Raptors<\u002Fx-import><\u002Fa>\n    <a href=\"#g-owls\" style=\"text-decoration:none;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,24px\">Owls<\u002Fx-import><\u002Fa>\n    <a href=\"#g-woodpeckers\" style=\"text-decoration:none;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,24px\">Woodpeckers and barbets<\u002Fx-import><\u002Fa>\n    <a href=\"#g-streams\" style=\"text-decoration:none;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,24px\">Streams<\u002Fx-import><\u002Fa>\n    <a href=\"#g-flocks\" style=\"text-decoration:none;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,24px\">Oak-forest flocks<\u002Fx-import><\u002Fa>\n  <\u002Fdiv>\n\n  <h2 id=\"g-pheasants\" style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin:36px 0 4px;scroll-margin-top:90px;\">Pheasants<\u002Fh2>\n  <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:16px;\">The reason most people come. All four are here; only one is easy.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;\">\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"82b5019e-2018-4219-9455-9d15a30e39a1\" alt=\"Cheer Pheasant\" width=\"1400\" height=\"1007\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Cheer Pheasant<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Catreus wallichii<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">CHEPH<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · grass slopes, pre-dawn<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"5f10c990-b517-4058-ac1d-195864d7f739\" alt=\"Koklass Pheasant\" width=\"1200\" height=\"799\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Koklass Pheasant<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Pucrasia macrolopha<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">KOKPH<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · heard more than seen<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Kalij Pheasant\" scientific-name=\"Lophura leucomelanos\" code=\"KALPH\" season=\"Resident · forest road at dusk\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Himalayan Monal\" scientific-name=\"Lophophorus impejanus\" code=\"HIMO1\" season=\"Higher ground · a bonus, not a target\" hint-size=\"100%,240px\"><\u002Fx-import>\n  <\u002Fdiv>\n\n  <h2 id=\"g-raptors\" style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin:36px 0 4px;scroll-margin-top:90px;\">Raptors and vultures<\u002Fh2>\n  <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:16px;\">Late morning, once the thermals build over the ridge.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;\">\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Steppe Eagle\" scientific-name=\"Aquila nipalensis\" code=\"STEA\" season=\"Winter and passage · from November\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Himalayan Griffon\" scientific-name=\"Gyps himalayensis\" code=\"HIGR\" season=\"Resident · over the ridges\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Mountain Hawk-Eagle\" scientific-name=\"Nisaetus nipalensis\" code=\"MHEA\" season=\"Resident · scarce\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Eurasian Sparrowhawk\" scientific-name=\"Accipiter nisus\" code=\"EUSP\" season=\"Winter · through the pines\" hint-size=\"100%,240px\"><\u002Fx-import>\n  <\u002Fdiv>\n\n  <h2 id=\"g-owls\" style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin:36px 0 4px;scroll-margin-top:90px;\">Owls<\u002Fh2>\n  <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:16px;\">Afternoon and dusk, and most of them will answer a whistle.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;\">\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"bec5d849-dadd-4e75-8632-c617489515d2\" alt=\"Asian Barred Owlet\" width=\"800\" height=\"1489\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Asian Barred Owlet<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Glaucidium cuculoides<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">ABOW<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · calls in daylight<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Collared Owlet\" scientific-name=\"Glaucidium brodiei\" code=\"COOW\" season=\"Resident · the four-note whistle\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Mountain Scops Owl\" scientific-name=\"Otus spilocephalus\" code=\"MSOW\" season=\"Resident · after dark\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Brown Wood Owl\" scientific-name=\"Strix leptogrammica\" code=\"BWOW\" season=\"Resident · scarce, Binsar\" hint-size=\"100%,240px\"><\u002Fx-import>\n  <\u002Fdiv>\n\n  <h2 id=\"g-woodpeckers\" style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin:36px 0 4px;scroll-margin-top:90px;\">Woodpeckers and barbets<\u002Fh2>\n  <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:16px;\">On the lichened pines beside every track.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;\">\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"84b5a982-d5df-4e46-9917-ce260b9a2cf8\" alt=\"Brown-fronted Woodpecker\" width=\"800\" height=\"832\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Brown-fronted Woodpecker<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Dendrocopos auriceps<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">BFWO<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · common<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Himalayan Woodpecker\" scientific-name=\"Dendrocopos himalayensis\" code=\"HIWO\" season=\"Resident · higher pines\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Greater Yellownape\" scientific-name=\"Chrysophlegma flavinucha\" code=\"GRYE\" season=\"Resident · oak forest\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Great Barbet\" scientific-name=\"Psilopogon virens\" code=\"GRBA\" season=\"Resident · loud, all day\" hint-size=\"100%,240px\"><\u002Fx-import>\n  <\u002Fdiv>\n\n  <h2 id=\"g-streams\" style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin:36px 0 4px;scroll-margin-top:90px;\">Streams and water<\u002Fh2>\n  <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:16px;\">The Chaubatia stream and the gullies below the Binsar ridge.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;\">\n      <a href=\"#/species\" style=\"display:block;color:inherit;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Spotted Forktail\" scientific-name=\"Enicurus maculatus\" code=\"SPFOR\" season=\"Resident · full guide\" hint-size=\"100%,240px\"><\u002Fx-import><\u002Fa>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Plumbeous Water Redstart\" scientific-name=\"Phoenicurus fuliginosus\" code=\"PLWR\" season=\"Resident · same streams\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"White-capped Redstart\" scientific-name=\"Phoenicurus leucocephalus\" code=\"WCRE\" season=\"Winter · on every stream\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Brown Dipper\" scientific-name=\"Cinclus pallasii\" code=\"BRDI\" season=\"Winter · lower water\" hint-size=\"100%,240px\"><\u002Fx-import>\n  <\u002Fdiv>\n\n  <h2 id=\"g-flocks\" style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin:36px 0 4px;scroll-margin-top:90px;\">Oak-forest flocks<\u002Fh2>\n  <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:16px;\">What a mixed flock is made of. Ten minutes of everything, then nothing for an hour.<\u002Fp>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;\">\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"65d8ec1e-a475-4129-97ad-669e292c838d\" alt=\"Himalayan Black-lored Tit\" width=\"800\" height=\"1007\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Himalayan Black-lored Tit<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Machlolophus xanthogenys<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">HBLT<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · common in scrub<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Rufous Sibia\" scientific-name=\"Heterophasia capistrata\" code=\"RUSI2\" season=\"Resident · everywhere\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"White-tailed Nuthatch\" scientific-name=\"Sitta himalayensis\" code=\"WTNU\" season=\"Resident · on the trunks\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Black-headed Jay\" scientific-name=\"Garrulus lanceolatus\" code=\"BHJA\" season=\"Resident · noisy\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Eurasian Jay\" scientific-name=\"Garrulus glandarius\" code=\"EUJA\" season=\"Resident · localised, Binsar\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Black-throated Sunbird\" scientific-name=\"Aethopyga saturata\" code=\"BTSU\" season=\"Resident · flowering trees\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"3d5d554c-8506-454d-b98b-f0c5c710e4bf\" alt=\"Rock Bunting\" width=\"800\" height=\"1192\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;object-position:45% 52%;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Rock Bunting<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Emberiza cia<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">ROBU<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · open ground<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"4be93cc4-4389-49f6-9751-fad222614315\" alt=\"Mountain Bulbul\" width=\"800\" height=\"1071\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Mountain Bulbul<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Ixos mcclellandii<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">MOBU<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · broadleaf and oak forest<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;height:100%;\">\n        <div style=\"height:120px;\"><img src=\"7bbc2360-3f3f-4345-8dbd-81498cc649f7\" alt=\"Slaty-headed Parakeet\" width=\"1000\" height=\"871\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\u002Fdiv>\n        <div style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1;\">\n          <div style=\"font-family:var(--font-display);font-size:18px;line-height:1.2;\">Slaty-headed Parakeet<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-secondary);\">Psittacula himalayana<\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;\">\n            <span style=\"font-family:var(--font-mono);font-size:11px;background:var(--surface-card-alt);padding:3px 8px;border-radius:var(--radius-sm);color:var(--text-muted);\">SHPA<\u002Fspan>\n            <span style=\"font-size:12.5px;color:var(--text-muted);text-align:right;\">Resident · flocks, afternoons<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Blue Whistling Thrush\" scientific-name=\"Myophonus caeruleus\" code=\"BWTH\" season=\"Resident · loud at dawn\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Long-tailed Broadbill\" scientific-name=\"Psarisomus dalhousiae\" code=\"LTBR\" season=\"Summer · lower forest\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Maroon Oriole\" scientific-name=\"Oriolus traillii\" code=\"MAOR\" season=\"Resident · oak canopy\" hint-size=\"100%,240px\"><\u002Fx-import>\n  <\u002Fdiv>\n\n  <div style=\"margin-top:40px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:clamp(22px,3vw,28px);display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between;\">\n    <div style=\"flex:1 1 380px;\">\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(20px,2.4vw,24px);margin-bottom:8px;\">Looking for something that is not on this list?<\u002Fh2>\n      <p style=\"font-size:15px;line-height:1.6;color:var(--text-secondary);\">Send me the name. I will tell you honestly whether it is findable from here, in which month, and whether it is worth building a morning around.<\u002Fp>\n    <\u002Fdiv>\n    <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" href=\"#/enquire\" hint-size=\"auto,44px\">Ask about a species<\u002Fx-import>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isSpecies }}\" hint-placeholder-val=\"{{ false }}\">\n<div>\n<div style=\"background:var(--surface-card-alt);border-bottom:1px solid var(--border-subtle);\">\n  <div style=\"max-width:1200px;margin:0 auto;padding:12px clamp(20px,4vw,32px);font-size:13px;color:var(--text-muted);\"><a href=\"#/home\">Home<\u002Fa> &nbsp;/&nbsp; <a href=\"#/birds\">Birds of Ranikhet<\u002Fa> &nbsp;/&nbsp; Spotted Forktail<\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(28px,4vw,36px) clamp(20px,4vw,32px) clamp(56px,8vw,96px);display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,56px);align-items:flex-start;\">\n  <div style=\"flex:1 1 460px;min-width:0;display:flex;flex-direction:column;gap:40px;\">\n    <div>\n      <div style=\"height:clamp(220px,30vw,340px);border-radius:var(--radius-lg);overflow:hidden;margin-bottom:22px;\"><image-slot id=\"sp-hero\" shape=\"rect\" placeholder=\"YOUR photo of the bird. Filename: spotted-forktail-chaubatia-january-2026.jpg\" src=\"19813c60-6cfc-4c3b-a028-2e487afcad01\"><\u002Fimage-slot><\u002Fdiv>\n      <h1 style=\"font-family:var(--font-display);font-size:clamp(28px,4vw,40px);line-height:1.08;\">Spotted Forktail<\u002Fh1>\n      <div style=\"font-family:var(--font-display);font-style:italic;font-size:21px;color:var(--text-secondary);margin-bottom:14px;\">Enicurus maculatus<\u002Fdiv>\n      <div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center;\">\n        <span style=\"font-family:var(--font-mono);font-size:12px;background:var(--surface-card-alt);padding:4px 10px;border-radius:var(--radius-sm);\">SPFOR<\u002Fspan>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"forest\" size=\"sm\" hint-size=\"auto,22px\">Resident<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"rust\" size=\"sm\" hint-size=\"auto,22px\">Year-round · easiest in winter<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Tag\" tone=\"neutral\" size=\"sm\" hint-size=\"auto,22px\">1,200–2,400m<\u002Fx-import>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <p style=\"font-size:clamp(16.5px,1.6vw,19px);line-height:1.6;color:var(--text-secondary);\">A stream bird, and one of the most dependable good sightings on the route. Where the pheasants need luck and a pre-dawn climb, forktails work a fixed stretch of water and come back to the same boulders every morning.<\u002Fp>\n\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin-top:10px;\">When is the best time to see a Spotted Forktail near Ranikhet?<\u002Fh2>\n      <p style=\"font-size:16px;line-height:1.7;color:var(--text-secondary);\">Year-round, though winter is easiest — birds drop to streams around 1,400–1,900m and concentrate on fewer stretches of water. Early morning and the last hour of light are best, when they feed along wet boulders. There is no narrow seasonal window here, which is why it is a good bird to build a trip around if your dates are fixed.<\u002Fp>\n\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin-top:10px;\">Where to look<\u002Fh2>\n      <p style=\"font-size:16px;line-height:1.7;color:var(--text-secondary);\">Fast, shaded streams with exposed boulders and leaf litter along the edge. The Chaubatia stream below the orchards is the reliable site near Ranikhet; the crossings inside Binsar hold a pair or two. Walk the water slowly and stop often — they flush ahead of you along the channel and settle again fifty metres on.<\u002Fp>\n\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin-top:10px;\">How to identify one<\u002Fh2>\n      <p style=\"font-size:16px;line-height:1.7;color:var(--text-secondary);\">Black and white, with a white forecrown, white-spotted black mantle, and a long deeply forked tail banded in white that it fans and pumps constantly. Slaty-backed Forktail is plain slate above with no spotting. Little Forktail is much smaller, with a short tail and a restless bobbing action.<\u002Fp>\n    <\u002Fdiv>\n\n    <div style=\"background:var(--forest-900);color:var(--text-on-inverse);border-radius:var(--radius-lg);padding:32px;\">\n      <div style=\"font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);margin-bottom:10px;\">See this bird with me<\u002Fdiv>\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);line-height:1.15;margin-bottom:10px;\">The Chaubatia stream is on every trip, in every month<\u002Fh2>\n      <p style=\"font-size:15.5px;line-height:1.6;color:var(--text-on-inverse-muted);margin-bottom:20px;max-width:620px;\">We walk it slowly on at least one morning, and in winter usually twice. If forktails matter to you, say so at enquiry and I'll build in the Binsar crossings as well.<\u002Fp>\n      <div style=\"display:flex;gap:12px;flex-wrap:wrap;\">\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" href=\"#/tour\" hint-size=\"auto,44px\">See the tour<\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" variant=\"secondary\" inverse=\"{{ true }}\" href=\"#/enquire\" hint-size=\"auto,44px\">Ask about stream mornings<\u002Fx-import>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div>\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin-bottom:16px;\">Common questions<\u002Fh2>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Accordion\" items=\"{{ speciesFaq }}\" default-open-index=\"{{ 0 }}\" hint-size=\"100%,260px\"><\u002Fx-import>\n    <\u002Fdiv>\n\n    <div>\n      <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin-bottom:6px;\">Seen on the same mornings<\u002Fh2>\n      <p style=\"font-size:14.5px;color:var(--text-muted);margin-bottom:16px;\">Internal links between species pages are half of why they rank. Every new page links to two or three others.<\u002Fp>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;\">\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Steppe Eagle\" scientific-name=\"Aquila nipalensis\" code=\"STEA\" season=\"Winter and passage · from November\" hint-size=\"100%,240px\"><\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Brown-fronted Woodpecker\" scientific-name=\"Dendrocopos auriceps\" code=\"BFWO\" season=\"Resident · on the pines\" hint-size=\"100%,240px\"><\u002Fx-import>\n        <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.SpeciesCard\" common-name=\"Himalayan Black-lored Tit\" scientific-name=\"Machlolophus xanthogenys\" code=\"HBLT\" season=\"Resident · common in scrub\" hint-size=\"100%,240px\"><\u002Fx-import>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"flex:1 1 300px;max-width:360px;position:sticky;top:80px;align-self:flex-start;display:flex;flex-direction:column;gap:16px;\">\n    <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:22px;display:flex;flex-direction:column;gap:12px;\">\n      <div style=\"font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);\">At a glance<\u002Fdiv>\n      <div style=\"display:flex;justify-content:space-between;font-size:14.5px;border-bottom:1px solid var(--border-subtle);padding-bottom:8px;\"><span style=\"color:var(--text-muted);\">Best months<\u002Fspan><strong>Nov – Feb<\u002Fstrong><\u002Fdiv>\n      <div style=\"display:flex;justify-content:space-between;font-size:14.5px;border-bottom:1px solid var(--border-subtle);padding-bottom:8px;\"><span style=\"color:var(--text-muted);\">Altitude<\u002Fspan><strong>1,200–2,400m<\u002Fstrong><\u002Fdiv>\n      <div style=\"display:flex;justify-content:space-between;font-size:14.5px;border-bottom:1px solid var(--border-subtle);padding-bottom:8px;\"><span style=\"color:var(--text-muted);\">Habitat<\u002Fspan><strong>Shaded rocky streams<\u002Fstrong><\u002Fdiv>\n      <div style=\"display:flex;justify-content:space-between;font-size:14.5px;border-bottom:1px solid var(--border-subtle);padding-bottom:8px;\"><span style=\"color:var(--text-muted);\">Time of day<\u002Fspan><strong>Dawn and dusk<\u002Fstrong><\u002Fdiv>\n      <div style=\"display:flex;justify-content:space-between;font-size:14.5px;\"><span style=\"color:var(--text-muted);\">IUCN status<\u002Fspan><strong>Least Concern<\u002Fstrong><\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:10px;\">\n      <div style=\"font-family:var(--font-display);font-size:19px;\">Want this bird on your list?<\u002Fdiv>\n      <p style=\"font-size:14px;line-height:1.6;color:var(--text-secondary);\">Forktails are on the route in every month. Tell me your dates and I'll build the stream walks around them.<\u002Fp>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" href=\"#/enquire\" hint-size=\"100%,44px\">Enquire<\u002Fx-import>\n    <\u002Fdiv>\n    <div style=\"background:var(--forest-900);color:var(--text-on-inverse);border-radius:var(--radius-lg);padding:20px;\">\n      <div style=\"font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);margin-bottom:10px;\">SEO checklist for this page<\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:7px;font-size:13px;line-height:1.5;color:var(--text-on-inverse-muted);\">\n        <div>Title tag: <em>Spotted Forktail near Ranikhet — where and when to see one<\u002Fem><\u002Fdiv>\n        <div>URL: /birds/spotted-forktail<\u002Fdiv>\n        <div>One H1, H2s phrased as real questions<\u002Fdiv>\n        <div>Answer in the first two sentences under each H2<\u002Fdiv>\n        <div>FAQPage schema on the accordion<\u002Fdiv>\n        <div>Image filename + alt text name the bird, place, month<\u002Fdiv>\n        <div>Links out to 2–3 other species pages and the tour<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isGallery }}\" hint-placeholder-val=\"{{ false }}\">\n<div>\n<div style=\"background:var(--forest-900);color:var(--text-on-inverse);\">\n  <div style=\"max-width:1200px;margin:0 auto;padding:clamp(36px,5vw,56px) clamp(20px,4vw,32px);\">\n    <div style=\"font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--rust-300);margin-bottom:12px;\">Photographs<\u002Fdiv>\n    <h1 style=\"font-family:var(--font-display);font-size:clamp(28px,4vw,42px);line-height:1.1;max-width:780px;margin-bottom:14px;color:#F8F4E9;\">Every photograph on this site is mine, taken on the ground we walk<\u002Fh1>\n    <p style=\"font-size:16.5px;line-height:1.65;color:var(--text-on-inverse-muted);max-width:660px;\">Not licensed, not stock, not borrowed from a better photographer. Left imperfect where the light was. Here is how you can check that yourself.<\u002Fp>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(28px,4vw,40px) clamp(20px,4vw,32px) 0;\">\n  <div style=\"background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:clamp(22px,3vw,30px);\">\n    <h2 style=\"font-family:var(--font-display);font-size:clamp(21px,2.5vw,26px);margin-bottom:8px;\">How to tell these are mine<\u002Fh2>\n    <p style=\"font-size:15px;line-height:1.65;color:var(--text-secondary);margin-bottom:22px;max-width:720px;\">You should not have to take my word for it, and there is no certificate for this sort of thing. What there is, is evidence you can check in about two minutes.<\u002Fp>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;\">\n      <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:20px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;color:var(--rust-600);margin-bottom:8px;\">01<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">The originals still carry their EXIF<\u002Fdiv>\n        <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Camera body, lens, shutter, ISO, date and time are written into every file. Ask for any frame at full size and read it yourself. Stock libraries strip that data, and a lifted image will show someone else\\u2019s camera or nothing at all.<\u002Fp>\n      <\u002Fdiv>\n      <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:20px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;color:var(--rust-600);margin-bottom:8px;\">02<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">One camera, one set of hills<\u002Fdiv>\n        <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">The whole collection comes off the same body and lens, frame numbers running in sequence, every location within a few kilometres of Majkhali. A set assembled from other people\\u2019s work never looks like that.<\u002Fp>\n      <\u002Fdiv>\n      <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:20px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;color:var(--rust-600);margin-bottom:8px;\">03<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">A public trail that predates this site<\u002Fdiv>\n        <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Most of these went up on <a href=\"https://www.instagram.com/vivsnaturescope\" target=\"_blank\" rel=\"noopener\">Instagram<\u002Fa> as they were taken, dated. Reverse image search any of them — they should lead back to me and nowhere else.<\u002Fp>\n      <\u002Fdiv>\n      <div style=\"background:var(--surface-card-alt);border-radius:var(--radius-md);padding:20px;\">\n        <div style=\"font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;color:var(--rust-600);margin-bottom:8px;\">04<\u002Fdiv>\n        <div style=\"font-family:var(--font-display);font-size:18px;margin-bottom:6px;\">The ordinary frames are here too<\u002Fdiv>\n        <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">A bought portfolio is all hero shots. Mine keeps the flat light, the distant birds and the half-obscured ones, because that is what these forests actually give you.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<div style=\"max-width:1200px;margin:0 auto;padding:clamp(36px,5vw,52px) clamp(20px,4vw,32px) clamp(56px,8vw,96px);\">\n  <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:20px;\">\n    <h2 style=\"font-family:var(--font-display);font-size:clamp(24px,3.2vw,32px);\">The collection<\u002Fh2>\n    <div style=\"font-size:14px;color:var(--text-muted);\">All of it within a few kilometres of Majkhali, Ranikhet and Binsar.<\u002Fdiv>\n  <\u002Fdiv>\n  <div style=\"columns:3 300px;column-gap:20px;\">\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"82b5019e-2018-4219-9455-9d15a30e39a1\" alt=\"Male Cheer Pheasant on a grass slope\" width=\"1400\" height=\"1007\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:1400/1007;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Cheer Pheasant<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Catreus wallichii · Vulnerable<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">The bird people travel for, and the one I am least willing to promise. This male stood in the open perhaps thirty seconds before walking back into the scrub.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"5f10c990-b517-4058-ac1d-195864d7f739\" alt=\"Male Koklass Pheasant in grass\" width=\"1200\" height=\"799\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:1200/799;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Koklass Pheasant<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Pucrasia macrolopha<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Usually only a voice at dawn. Getting one in the open, in light, is a matter of being in place before it is bright enough to see.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"bec5d849-dadd-4e75-8632-c617489515d2\" alt=\"Asian Barred Owlet on a dead pine snag\" width=\"800\" height=\"1489\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:800/1489;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Asian Barred Owlet<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Glaucidium cuculoides<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Calling from a dead pine in the fog. It answered a whistled imitation three times before losing interest.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"186e9372-e658-4bce-814a-7ce85f4a609f\" alt=\"Trishul in last light\" width=\"1400\" height=\"1336\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:1400/1336;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Trishul in last light<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">From the Binsar ridge<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Two minutes of colour on the summit, then the whole face went flat. Worth standing outside for on any clear evening.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"65d8ec1e-a475-4129-97ad-669e292c838d\" alt=\"Himalayan Black-lored Tit on a thin branch\" width=\"800\" height=\"1007\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:800/1007;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Himalayan Black-lored Tit<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Machlolophus xanthogenys<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Crest up, working seed heads at the edge of the orchards. A bird you will see on any morning here, and none the worse for it.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"84b5a982-d5df-4e46-9917-ce260b9a2cf8\" alt=\"Brown-fronted Woodpecker on a pine trunk\" width=\"800\" height=\"832\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:800/832;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Brown-fronted Woodpecker<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Dendrocopos auriceps<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">On the lichened pines beside the track. Usually the first woodpecker of any morning out of Majkhali.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"3d5d554c-8506-454d-b98b-f0c5c710e4bf\" alt=\"Rock Bunting on a bare branch\" width=\"800\" height=\"1192\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:800/1192;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Rock Bunting<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Emberiza cia<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">A small party feeding on the open ground above the orchards. This one sat up long enough to be worth the frame.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"4be93cc4-4389-49f6-9751-fad222614315\" alt=\"Mountain Bulbul perched on a bare branch\" width=\"800\" height=\"1071\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:800/1071;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Mountain Bulbul<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Ixos mcclellandii<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">A forest bulbul rather than a garden one — shaggy brown crest, olive above, and usually heard in the canopy of a broadleaf patch before it is seen. Moves through in noisy small parties.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"7bbc2360-3f3f-4345-8dbd-81498cc649f7\" alt=\"Slaty-headed Parakeet in a tree\" width=\"1000\" height=\"871\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:1000/871;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Slaty-headed Parakeet<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Psittacula himalayana<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">A screeching flock coming through the orchards in the afternoon. They rarely settle for long, so this was more luck than craft.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"ded42708-a169-4213-96d0-e121468f4763\" alt=\"Pine forest above Majkhali with light through the trees\" width=\"1200\" height=\"750\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:1200/750;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">The pine forest, mid-morning<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Above Majkhali<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Not every frame has a bird in it. This is the ground you actually spend the days on — open pine, easy walking, and light like this once the sun clears the ridge.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"c36be789-fba4-486e-86ab-7cf8221905f8\" alt=\"Mist filling the valley below the ridge\" width=\"900\" height=\"1200\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:900/1200;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Mist in the valley<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Looking down from the ridge<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">Cloud sitting in the valley with the ridges above it. A morning like this can mean nothing moves for an hour, and then everything does at once.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n      <figure style=\"break-inside:avoid;margin:0 0 20px;background:var(--surface-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;\">\n        <img src=\"20021629-aaab-4986-91a8-9eebc11a841f\" alt=\"Sunset over the Kumaon ridges\" width=\"1563\" height=\"2048\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:auto;aspect-ratio:1563/2048;display:block;\">\n        <figcaption style=\"padding:16px 18px 18px;\">\n          <div style=\"font-family:var(--font-display);font-size:19px;line-height:1.2;\">Sunset over the Kumaon ridges<\u002Fdiv>\n          <div style=\"font-family:var(--font-display);font-style:italic;font-size:13.5px;color:var(--text-muted);margin-bottom:8px;\">Looking west from Majkhali<\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.55;color:var(--text-secondary);\">The view from the cottage. Ridge behind ridge going blue, and the pines going black in front of them.<\u002Fp>\n        <\u002Ffigcaption>\n      <\u002Ffigure>\n  <\u002Fdiv>\n  <div style=\"display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between;margin-top:20px;padding-top:20px;border-top:1px solid var(--border-subtle);\">\n    <div style=\"font-size:13.5px;line-height:1.6;color:var(--text-muted);max-width:560px;\">© Vivasvat Chauhan, Majkhali. Happy to send any frame at full resolution with its metadata intact, or to license one — just ask.<\u002Fdiv>\n    <div style=\"display:flex;gap:10px;flex-wrap:wrap;\">\n      <a href=\"https://www.instagram.com/vivsnaturescope\" target=\"_blank\" rel=\"noopener\" style=\"text-decoration:none;\"><x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" variant=\"secondary\" hint-size=\"auto,44px\">More on Instagram<\u002Fx-import><\u002Fa>\n      <x-import component-from-global-scope=\"RanikhetBirdwatchingDesignSystem_61f767.Button\" href=\"#/enquire\" hint-size=\"auto,44px\">Enquire about a tour<\u002Fx-import>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<div style=\"background:var(--forest-900);color:var(--text-on-inverse);margin-top:0;\">\n  <div style=\"max-width:1200px;margin:0 auto;padding:clamp(40px,6vw,56px) clamp(20px,4vw,32px) 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:32px;\">\n    <div>\n      <div style=\"font-family:var(--font-display);font-size:22px;margin-bottom:10px;\">Viv's Nature Scope<\u002Fdiv>\n      <p style=\"font-size:14.5px;line-height:1.6;color:var(--text-on-inverse-muted);max-width:280px;\">Small-group guided birding around Ranikhet, in the Kumaon hills.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"display:flex;flex-direction:column;gap:10px;\">\n      <div style=\"font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);\">The tour<\u002Fdiv>\n      <a href=\"#/tour\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Ranikhet, 3–4 days<\u002Fa>\n      <a href=\"#/tour\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Binsar, 3 days<\u002Fa>\n      <a href=\"#/tour\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Dates and prices<\u002Fa>\n      <a href=\"#/tour\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Private trips<\u002Fa>\n    <\u002Fdiv>\n    <div style=\"display:flex;flex-direction:column;gap:10px;\">\n      <div style=\"font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);\">Practical<\u002Fdiv>\n      <a href=\"#/tour\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Getting to Ranikhet<\u002Fa>\n      <a href=\"#/tour\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">What to bring<\u002Fa>\n      <a href=\"#/tour\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Payment and cancellation<\u002Fa>\n    <\u002Fdiv>\n    <div style=\"display:flex;flex-direction:column;gap:10px;\">\n      <div style=\"font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);\">Contact<\u002Fdiv>\n      <a href=\"#/enquire\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Enquire<\u002Fa>\n      <span style=\"font-size:14px;color:var(--text-on-inverse-muted);\">WhatsApp +91 99719 24583<\u002Fspan>\n      <a href=\"https://www.instagram.com/vivsnaturescope\" target=\"_blank\" rel=\"noopener\" style=\"font-size:14px;color:var(--text-on-inverse-muted);\">Instagram · @vivsnaturescope<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <div style=\"max-width:1200px;margin:0 auto;padding:18px clamp(20px,4vw,32px) 40px;border-top:1px solid rgba(248,244,233,.14);font-size:13px;color:var(--text-on-inverse-muted);\">© Viv's Nature Scope · Ranikhet, Uttarakhand<\u002Fdiv>\n<\u002Fdiv>\n\n<sc-if value=\"{{ notesVisible }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"position:fixed;right:20px;bottom:20px;width:min(330px,calc(100vw - 40px));max-height:60vh;overflow:auto;background:var(--forest-900);color:var(--text-on-inverse);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:18px 20px 20px;z-index:50;\">\n  <div style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;\">\n    <div style=\"font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--rust-300);\">Note<\u002Fdiv>\n    <button sc-camel-on-click=\"{{ toggleNotes }}\" style=\"background:none;border:none;color:var(--text-on-inverse-muted);font-size:20px;cursor:pointer;line-height:1;padding:0;width:44px;height:44px;margin:-12px -12px -12px 0;\">×<\u002Fbutton>\n  <\u002Fdiv>\n  <div style=\"display:flex;flex-direction:column;gap:12px;font-size:13.5px;line-height:1.55;color:var(--text-on-inverse-muted);\">\n    <sc-if value=\"{{ isPlan }}\" hint-placeholder-val=\"{{ true }}\"><div>Home, two tours, enquiry and photographs. Everything with an em-dash or square brackets is a blank for you to fill. Toggle these notes off in Tweaks.<\u002Fdiv><\u002Fsc-if>\n    <sc-if value=\"{{ isHome }}\" hint-placeholder-val=\"{{ false }}\"><div>\n      <div style=\"margin-bottom:8px;\">The hero leads on what you actually have — \"never more than six of you, always guided by me, on the ridges I walk anyway\". Small groups and local knowledge do the work a confession of inexperience used to do, without inviting doubt.<\u002Fdiv>\n      <div>The Recent mornings log replaces testimonials. Add one every week; in three months it's the most convincing thing on the site, and it costs you nothing but a photo and two sentences.<\u002Fdiv>\n    <\u002Fdiv><\u002Fsc-if>\n    <sc-if value=\"{{ isTour }}\" hint-placeholder-val=\"{{ false }}\"><div>\n      <div style=\"margin-bottom:8px;\"><strong style=\"color:var(--text-on-inverse);\">Ranikhet / Binsar<\u002Fstrong> — the pills beside the breadcrumb switch tours. Ranikhet is the Cheer Pheasant ridges from Majkhali; Binsar is two nights inside the sanctuary. Each has its own dates, price, sites and included list.<\u002Fdiv>\n      <div style=\"margin-bottom:8px;\"><strong style=\"color:var(--text-on-inverse);\">Flexible vs Fixed<\u002Fstrong> — Flexible is the better fit while you're starting: it sells the shape of a day plus a menu of sites, so nothing goes stale when a morning changes. The two length options carry the concrete detail. Switch to Fixed once a route is settled enough to print day by day.<\u002Fdiv>\n      <div>Fill the prices before this goes live. Everything reads as a <strong style=\"color:var(--text-on-inverse);\">from<\u002Fstrong> figure except the fixed departures, which carry one real price each — that is the only place a number is a commitment.<\u002Fdiv>\n    <\u002Fdiv><\u002Fsc-if>\n    <sc-if value=\"{{ isGallery }}\" hint-placeholder-val=\"{{ false }}\"><div>\n      <div style=\"margin-bottom:8px;\">The one page where adding more is always right — every frame you post makes the operation look more real, and it costs you nothing but a caption.<\u002Fdiv>\n      <div>The Recent mornings log on the homepage still carries dates and places — that is where the \"these are real, and recent\" work happens. This page is just the photographs.<\u002Fdiv>\n    <\u002Fdiv><\u002Fsc-if>\n    <sc-if value=\"{{ isEnquire }}\" hint-placeholder-val=\"{{ false }}\"><div>Make sure this actually sends somewhere and that you've tested it from a phone. A silently broken form is the most common way a small operator loses every enquiry for a month.<\u002Fdiv><\u002Fsc-if>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n<sc-if value=\"{{ notesHidden }}\" hint-placeholder-val=\"{{ false }}\">\n<button sc-camel-on-click=\"{{ toggleNotes }}\" style=\"position:fixed;right:20px;bottom:20px;z-index:50;background:var(--forest-900);color:var(--text-on-inverse);border:none;border-radius:var(--radius-pill);padding:11px 18px;font-family:var(--font-body);font-size:13.5px;font-weight:600;cursor:pointer;box-shadow:var(--shadow-md);\">Show notes<\u002Fbutton>\n<\u002Fsc-if>\n\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1280},&quot;showNotes&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Prototype&quot;}}\">\nclass Component extends DCLogic {\n  state = { page: 'plan', notesOpen: true, dayMode: 'flexible', tour: 'ranikhet' };\n\n  setDayMode = (m) => () => this.setState({ dayMode: m });\n  setTour = (t) => () => this.setState({ tour: t });\n  pickTour = (t) => () => this.setState({ tour: t });\n\n  tabStyle(active) {\n    return 'padding:11px 20px;min-height:44px;border-radius:var(--radius-pill);border:none;font-family:var(--font-body);font-size:14px;font-weight:600;cursor:pointer;'\n      + (active ? 'background:var(--rust-500);color:#fff;' : 'background:transparent;color:var(--text-muted);');\n  }\n\n  onNav = (e) => {\n    const a = e.target.closest && e.target.closest('a');\n    if (!a) return;\n    const h = a.getAttribute('href') || '';\n    if (h.indexOf('#/') === 0) {\n      e.preventDefault();\n      this.setState({ page: h.slice(2) });\n      if (window.scrollTo) window.scrollTo(0, 0);\n    }\n  };\n\n  toggleNotes = () => this.setState(s => ({ notesOpen: !s.notesOpen }));\n\n  renderVals() {\n    const p = this.state.page;\n    const showNotes = this.props.showNotes ?? true;\n    return {\n      onNav: this.onNav,\n      toggleNotes: this.toggleNotes,\n      isPlan: p === 'plan', isHome: p === 'home', isTour: p === 'tour', isEnquire: p === 'enquire',\n      isSpecies: p === 'species',\n      isBirds: p === 'birds',\n      speciesFaq: [\n        { question: 'When is the best time to see a Spotted Forktail near Ranikhet?', answer: 'Year-round, but winter is easiest — birds move down to streams around 1,400–1,900m and are far less scattered. Early morning and late afternoon, when they feed along the wet boulders. Unlike the pheasants there is no narrow window, which makes this one of the most dependable good birds on the route.' },\n        { question: 'Where exactly do you find them?', answer: 'Fast, shaded streams with exposed boulders and leaf litter at the edges. The Chaubatia stream below the orchards is the reliable spot near Ranikhet, and the Binsar stream crossings hold a pair or two. Walk the water, not the ridge.' },\n        { question: 'How do you tell it from a Slaty-backed Forktail?', answer: 'The Spotted has a white-spotted black mantle and a longer, deeply forked tail with broader white bands. Slaty-backed is plain slate above with no spotting. Little Forktail is much smaller with a short, barely forked tail and bobs constantly.' },\n        { question: 'Is it a good bird for photography?', answer: 'One of the best on the route. It works a predictable stretch of stream, comes back to the same boulders, and tolerates a still observer. The difficulty is light — deep shade and high contrast between black and white plumage.' }\n      ],\n      isGallery: p === 'gallery',\n      isRanikhetTour: this.state.tour === 'ranikhet',\n      isBinsarTour: this.state.tour === 'binsar',\n      showRanikhet: this.setTour('ranikhet'),\n      showBinsar: this.setTour('binsar'),\n      pickRanikhet: this.pickTour('ranikhet'),\n      pickBinsar: this.pickTour('binsar'),\n      tabRanikhetStyle: this.tabStyle(this.state.tour === 'ranikhet'),\n      tabBinsarStyle: this.tabStyle(this.state.tour === 'binsar'),\n      fixedLabel: this.state.tour === 'binsar' ? 'Fixed 3-day' : 'Fixed 4-day',\n      isFlexible: this.state.dayMode === 'flexible',\n      isFixed: this.state.dayMode === 'fixed',\n      showFlexible: this.setDayMode('flexible'),\n      showFixed: this.setDayMode('fixed'),\n      tabFlexStyle: this.state.dayMode === 'flexible'\n        ? 'padding:12px 20px;min-height:44px;border-radius:var(--radius-pill);border:none;font-family:var(--font-body);font-size:14px;font-weight:600;cursor:pointer;background:var(--rust-500);color:#fff;'\n        : 'padding:12px 20px;min-height:44px;border-radius:var(--radius-pill);border:none;font-family:var(--font-body);font-size:14px;font-weight:600;cursor:pointer;background:transparent;color:var(--text-muted);',\n      tabFixedStyle: this.state.dayMode === 'fixed'\n        ? 'padding:12px 20px;min-height:44px;border-radius:var(--radius-pill);border:none;font-family:var(--font-body);font-size:14px;font-weight:600;cursor:pointer;background:var(--rust-500);color:#fff;'\n        : 'padding:12px 20px;min-height:44px;border-radius:var(--radius-pill);border:none;font-family:var(--font-body);font-size:14px;font-weight:600;cursor:pointer;background:transparent;color:var(--text-muted);',\n      notesVisible: showNotes && this.state.notesOpen,\n      notesHidden: showNotes && !this.state.notesOpen,\n      navLinks: [\n        { label: 'The tour', href: '#/tour' },\n        { label: 'Birds', href: '#/species' },\n        { label: 'Home', href: '#/home' },\n        { label: 'Launch plan', href: '#/plan' }\n      ],\n      tourCrumbs: [\n        { label: 'Home', href: '#/home' },\n        { label: 'Tours', href: '#/home' },\n        { label: this.state.tour === 'binsar' ? 'Binsar' : 'Ranikhet' }\n      ],\n      homeFaq: [\n        { question: 'Why book with you rather than a larger operator?', answer: \"Because I'm based here, at a small cottage near Ranikhet, and I walk these ridges whether or not anyone has booked. You get the person who knows which slope held birds last week, not a driver and a checklist. Groups never exceed six, and everything on this site is checkable — the exact route, the lodges by name, my own photographs, and a price with nothing hidden.\" },\n        { question: 'How do I get to Ranikhet from outside India?', answer: 'Fly into Delhi, then either a short flight to Pantnagar and a 3-hour drive, or the overnight train to Kathgodam and a 3-hour drive. I meet you at either and the transfer is included both ways.' },\n        { question: 'Do I need to be fit?', answer: '3 to 5km a day on graded forest road, with one gentle climb. No camping, nothing above 2,450m. If you can walk a few kilometres on uneven ground you will be fine — and tell me at enquiry if anything worries you.' },\n        { question: 'What if only one person books?', answer: \"Then the trip runs with one person, at the same price. Groups are capped at six and this season most will be smaller.\" },\n        { question: 'What does it cost, all in?', answer: 'The published price covers every land cost: rooms, all meals, vehicle, guiding, permits and transfers. On top you need flights, an India e-visa of about $25, insurance, and a single supplement if you want your own room.' }\n      ],\n      tourFaq: [\n        { question: 'Can I see a Himalayan Monal on this trip?', answer: \"Not reliably, and I would rather say so now. The dependable Monal ground sits higher and further out than this route goes. If Monal is the reason you are coming, tell me at enquiry — I will either build a longer trip that reaches it, or point you to someone better placed for it.\" },\n        { question: 'Where do we stay?', answer: 'On the Ranikhet tour, at Firwood Cottage in Majkhali — simple, clean, hot water, heated in winter. On the Binsar tour, at the forest rest house inside the sanctuary, which is basic on purpose: being inside at first light is the whole point. I will send photographs of either before you commit.' },\n        { question: 'Is it suitable for a photographer?', answer: 'Partly. The forest is dark and this is a walking trip at a birding pace, so expect record shots rather than portfolio images. If photography is the point, say so and I will slow the route down and build in longer sits.' },\n        { question: 'When do I pay, and what if I cancel?', answer: '20% deposit to confirm, balance 30 days before arrival. Full refund of the deposit up to 45 days out, 50% up to 21 days. Bank transfer or UPI; I can invoice in USD, GBP or INR.' },\n        { question: 'What should I bring?', answer: 'Binoculars, layers for 4°C at dawn in winter, boots with grip for wet track, and a torch for the rest house. I send a full list with the itinerary. Scopes are useful but not essential on this route.' }\n      ],\n      footerColumns: []\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>